+/**
+ * Progression intra-note : compare les contrôles écrits consécutifs de MÊME
+ * type (C1→C2→C3, ou compréhension 1→2, production 1→2). On ne mélange jamais
+ * deux natures différentes (un final anglais n'est pas comparé à un court). Le
+ * classement suit le même seuil que le serveur : ±0,5 point.
+ */
+function noteProgression(evaluations: EvalComponent[] | undefined) {
+  if (!Array.isArray(evaluations)) return null
+  const controls = evaluations
+    .filter(e => e.category === 'control')
+    .sort((a, b) => a.ordinal - b.ordinal)
+  if (controls.length < 2) return null
+  const byKind = new Map<string, EvalComponent[]>()
+  controls.forEach(c => { const r = byKind.get(c.kind) || []; r.push(c); byKind.set(c.kind, r) })
+  const steps: { from: number; to: number; delta: number }[] = []
+  byKind.forEach(list => {
+    for (let i = 1; i < list.length; i++) {
+      steps.push({ from: list[i - 1].note, to: list[i].note, delta: Math.round((list[i].note - list[i - 1].note) * 10) / 10 })
+    }
+  })
+  if (steps.length === 0) return null
+  const last = steps[steps.length - 1].delta
+  const outcome: 'improved' | 'declined' | 'stable' = last >= 0.5 ? 'improved' : last <= -0.5 ? 'declined' : 'stable'
+  return { steps, last, outcome }
+}
+
+/** Détail déplié d'une note v2 : contrôles, activités intégrées et suivi. */
