+  const integrated = evals.filter(e => e.category === 'integrated')
+  const prog = noteProgression(evals)
+  const rate = note.calculation?.completionRate ?? (note.calculation?.status === 'complete' ? 100 : null)
+  const provisional = note.calculation?.status === 'provisional'
+  const bareme = note.bareme || 20
+
+  const arrow = prog?.outcome === 'improved' ? '▲' : prog?.outcome === 'declined' ? '▼' : '＝'
+  const progColor = prog?.outcome === 'improved' ? C.primary : prog?.outcome === 'declined' ? 'var(--color-danger)' : 'var(--color-text-muted)'
+
+  return (
+    <div style={{ padding: '12px 18px', background: 'var(--color-bg-subtle)', borderTop: '1px solid var(--color-border)' }}>
+      <div style={{ display: 'flex', flexWrap: 'wrap', gap: '18px', alignItems: 'flex-start' }}>
+        {/* Contrôles écrits */}
+        <div style={{ flex: '1 1 260px' }}>
+          <div style={{ fontSize: '11px', fontWeight: 800, textTransform: 'uppercase', color: 'var(--color-text-subtle)', marginBottom: '6px' }}>
+            {t('notes_controls_label', 'Contrôles écrits')}
+          </div>
+          <div style={{ display: 'flex', flexWrap: 'wrap', gap: '6px' }}>
+            {controls.map(c => (
+              <div key={c.slot} style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '2px', background: 'var(--color-surface)', border: '1px solid var(--color-border)', borderRadius: '8px', padding: '6px 10px', minWidth: '58px' }}>
+                <span style={{ fontSize: '10px', fontWeight: 700, color: 'var(--color-text-subtle)' }}>{c.label}</span>
+                <NoteBadge val={c.note} max={bareme} />
+              </div>
+            ))}
+          </div>
+        </div>
+
+        {/* Activités intégrées */}
+        {integrated.length > 0 && (
+          <div style={{ flex: '0 1 160px' }}>
+            <div style={{ fontSize: '11px', fontWeight: 800, textTransform: 'uppercase', color: 'var(--color-text-subtle)', marginBottom: '6px' }}>
+              {t('notes_integrated_label', 'Activités intégrées')}
+            </div>
+            {integrated.map(a => (
+              <div key={a.slot} style={{ display: 'inline-flex', flexDirection: 'column', alignItems: 'center', gap: '2px', background: 'var(--color-surface)', border: '1px solid var(--color-border)', borderRadius: '8px', padding: '6px 10px' }}>
+                <NoteBadge val={a.note} max={a.bareme} />
+              </div>
+            ))}
+          </div>
+        )}
+
+        {/* Suivi de progression */}
+        <div style={{ flex: '0 1 200px' }}>
+          <div style={{ fontSize: '11px', fontWeight: 800, textTransform: 'uppercase', color: 'var(--color-text-subtle)', marginBottom: '6px' }}>
+            {t('notes_progress_label', 'Suivi')}
+          </div>
+          {prog ? (
+            <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
+              <span style={{ fontSize: '18px', color: progColor, fontWeight: 800 }}>{arrow}</span>
+              <span style={{ fontSize: '13px', fontWeight: 700, color: progColor }}>
+                {prog.last > 0 ? '+' : ''}{prog.last} {t('notes_points_short', 'pts')}
+              </span>
+            </div>
+          ) : (
+            <span style={{ fontSize: '12px', color: 'var(--color-text-muted)' }}>{t('notes_progress_insufficient', 'Pas assez de contrôles')}</span>
+          )}
+          {rate != null && (
+            <div style={{ marginTop: '6px', fontSize: '11px', color: provisional ? C.warn : 'var(--color-text-muted)', fontWeight: 600 }}>
+              {provisional ? t('notes_provisional', 'Provisoire') + ' · ' : ''}{rate}%
+            </div>
+          )}
+        </div>
+      </div>
+    </div>
+  )
+}
