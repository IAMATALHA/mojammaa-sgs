{
  "expo": {
    "name": "Mojammaa Connect",
    "slug": "mojammaa-sgs",
    "version": "1.0.18",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFBEB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.youssefatalha.mojammaasgs"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFBEB"
      },
      "backgroundColor": "#FFFBEB",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.youssefatalha.mojammaasgs",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "mojammaa.com", "path": "/activer" },
            { "scheme": "https", "host": "mojammaa.com", "path": "/parents/activer" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/with-launch-link-intent",
      "expo-localization",
      "expo-font",
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#A61B1B",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6ff4e5d9-040f-45df-ac65-5cf941ad8627"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6ff4e5d9-040f-45df-ac65-5cf941ad8627"
    }
  }
}
