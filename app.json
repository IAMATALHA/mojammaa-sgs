{
  "expo": {
    "name": "Mojammaa Connect",
    "slug": "mojammaa-sgs",
    "version": "1.0.14",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFBEB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.youssefatalha.mojammaasgs"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFBEB"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.youssefatalha.mojammaasgs",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#D00302",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6ff4e5d9-040f-45df-ac65-5cf941ad8627"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6ff4e5d9-040f-45df-ac65-5cf941ad8627"
    }
  }
}
