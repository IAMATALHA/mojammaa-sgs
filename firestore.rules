rules_version = '2';

// ============================================================================
//  RÈGLES DURCIES — PROPOSITION (à RELIRE + TESTER avant déploiement)
//
//  Objectif : un compte ne lit QUE ses données.
//    - parent  → son/ses enfant(s) (eleves.parentUid == uid) et leurs notes/absences
//    - prof    → uniquement SES classes (teacherTeaches) + SA matière pour les notes
//    - admin   → tout
//
//  ⚠️ AVANT DE DÉPLOYER :
//   1) Tester avec l'émulateur Firestore / un projet de staging, car des
//      règles plus strictes peuvent REJETER des requêtes existantes de l'app
//      (Firestore ne filtre pas : une requête qui POURRAIT toucher un doc
//       interdit est refusée en entier). Points à vérifier :
//        • Le dashboard PARENT doit interroger notes/absences par enfant
//          (eleveId / parentUid), PAS par classe seule.
//        • Le prof lit eleves/notes/absences de SES classes uniquement.
//   2) Déployer depuis UN SEUL endroit (ce fichier = la source unique).
//   3) Renommer en firestore.rules une fois validé.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }
    function myUid()      { return request.auth.uid; }
    function myDoc()      { return get(/databases/$(database)/documents/users/$(myUid())).data; }
    function myRole()     { return isSignedIn() ? myDoc().role : ''; }
    function isAdmin()    { return myRole() == 'admin'; }
    function isTeacher()  { return myRole() == 'professeur'; }
    function isParent()   { return myRole() == 'parent'; }
    function myClasses()  { return myDoc().classes != null ? myDoc().classes : []; }

    // ── Super-admin ──────────────────────────────────────────
    // Liste blanche dans config/superadmins (modifiable UNIQUEMENT via
    // scripts/setSuperadmin.js — admin SDK). Aucun client ne peut s'y ajouter.
    // Les superadmins gardent role:'admin' ; ce niveau ne fait qu'AJOUTER des
    // pouvoirs réservés (gestion des comptes/rôles, suppressions, audit).
    function superadminUids() {
      return get(/databases/$(database)/documents/config/superadmins).data.uids;
    }
    function isSuperAdmin() {
      return isSignedIn() && (myUid() in superadminUids());
    }

    // Le prof enseigne-t-il cette classe ? (tableau `classes` ou legacy `classe`)
    function teacherTeaches(classe) {
      return isTeacher() && (classe in myClasses() || classe == myDoc().classe);
    }
    // parentUid de l'élève ciblé (pour vérifier qu'un parent lit bien SON enfant)
    function eleveParentUid(eleveId) {
      return get(/databases/$(database)/documents/eleves/$(eleveId)).data.parentUid;
    }
    // Classe RÉELLE de l'élève ciblé (anti-injection 2026-07-11) : un prof ne
    // peut créer une note/absence/comportement QUE si l'élève appartient bien
    // à la classe déclarée dans le doc. Sans ce get(), un prof pouvait écrire
    // `classe: sa-classe, eleveId: élève-d-ailleurs` et le parent de la victime
    // voyait la donnée forgée (sa lecture ne filtre que sur eleveId).
    // ⚠️ COÛT : 1 get() par doc écrit → les batchs client doivent rester ≤ 10
    // docs (limite Firestore : 20 accès règles par batch). Les écrans appel &
    // import de notes committent par chunks (src/utils/firestoreBatch.ts).
    function eleveIsInClasse(eleveId, classe) {
      return get(/databases/$(database)/documents/eleves/$(eleveId)).data.classe == classe;
    }
    // Champs non modifiés par cet update (immutabilité sélective).
    function untouched(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }
    // Un champ tableau ne peut évoluer qu'en AJOUTANT son propre uid
    // (ou rester inchangé). Utilisé pour readBy/deletedBy des messages :
    // pas de retrait, pas d'ajout d'un autre uid, pas de réécriture.
    function selfAppendOnly(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
        || (request.resource.data[field] is list
            && request.resource.data[field].hasAll(resource.data.get(field, []))
            && request.resource.data[field].hasOnly(resource.data.get(field, []).concat([myUid()])));
    }

    // ── users ────────────────────────────────────────────────
    match /users/{uid} {
      allow read:           if isSignedIn() && (uid == myUid() || isAdmin());
      // Créer/supprimer un compte : SUPERADMIN uniquement.
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin()
        // Admin : gère les profils (nom, classes, matière…) mais PAS le rôle.
        || (isAdmin() &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        // Soi-même : son profil SAUF champs sensibles (anti auto-élévation).
        || (isSignedIn() && uid == myUid() &&
            !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['role', 'classes', 'classe', 'matiere', 'cycle', 'uid']));
    }

    // ── eleves ───────────────────────────────────────────────
    match /eleves/{eleveId} {
      allow read: if isAdmin()
                  || (isParent()  && resource.data.parentUid == myUid())
                  || teacherTeaches(resource.data.classe);
      allow create: if isAdmin() || teacherTeaches(request.resource.data.classe);
      // Durci 2026-07-11 : l'ancienne règle ne validait que la NOUVELLE classe —
      // un prof pouvait cibler N'IMPORTE QUEL élève par ID (écriture aveugle,
      // pas besoin du droit de lecture) et le "capturer" en posant sa classe.
      // Désormais : ancienne ET nouvelle classe dans son périmètre, et
      // `parentUid` intouchable (sinon rattachement de l'enfant d'autrui à un
      // parent complice → fuite de toutes ses données).
      allow update: if isAdmin()
        || (teacherTeaches(resource.data.classe)
            && teacherTeaches(request.resource.data.classe)
            && untouched(['parentUid']));
      allow delete: if isSuperAdmin();
    }

    // ── notes ────────────────────────────────────────────────
    match /notes/{noteId} {
      // CONFIDENTIALITÉ FERMÉE (2026-06-22) — le parent ne lit QUE les notes
      // de SES enfants. L'agrégat serveur ANONYME (classStats, CF onNoteWritten)
      // fournit moyenne de classe + rang depuis Batch 1 (v1.0.4, 2026-06-10) ;
      // useParentNotes interroge `notes where eleveId == enfant` (jamais la
      // classe entière) → cette requête par-enfant reste autorisée. Données
      // live vérifiées 2026-06-22 : 100% des notes.eleveId == ID doc eleves,
      // donc eleveParentUid(eleveId) résout. (Ancien getClassNotes() supprimé
      // depuis v1.0.4 ; builds < 1.0.4 verraient leur requête classe refusée.)
      //
      // PROF restreint à SA matière (2026-06-25) — un prof ne lit QUE les notes
      // de SES classes ET de SA matière (parité avec la règle d'écriture). Les
      // lectures inter-matières (stats classe tous-sujets) ont été retirées du
      // client : TeacherNotesScreen interroge `where matiere == profile.matiere`,
      // donc reste autorisé. Un prof sans `matiere` (ancien compte) ne lit/écrit
      // aucune note — il ne peut de toute façon pas en saisir (règle write).
      allow read: if isAdmin()
                  || (teacherTeaches(resource.data.classe)
                      && resource.data.matiere == myDoc().matiere)
                  || (isParent() && eleveParentUid(resource.data.eleveId) == myUid());
      // Prof : uniquement SA classe ET SA matière. Admin : tout.
      // Durci 2026-07-11 (anti-injection + anti-détournement) :
      //  - create : l'élève doit RÉELLEMENT appartenir à la classe déclarée
      //    (sinon note forgée visible par le parent d'un élève d'ailleurs) ;
      //  - update : on valide la classe EXISTANTE (plus seulement la nouvelle)
      //    et eleveId/classe/matiere deviennent immuables — un prof ne peut
      //    plus s'approprier une note hors périmètre en réécrivant sa classe.
      //    (L'app réécrit ces champs à l'identique via set+merge → inchangés,
      //    donc hors affectedKeys : aucun flux existant n'est cassé.)
      allow create: if isAdmin() || (
        teacherTeaches(request.resource.data.classe)
        && request.resource.data.matiere == myDoc().matiere
        && eleveIsInClasse(request.resource.data.eleveId, request.resource.data.classe)
      );
      allow update: if isAdmin() || (
        teacherTeaches(resource.data.classe)
        && resource.data.matiere == myDoc().matiere
        && untouched(['eleveId', 'classe', 'matiere'])
      );
      allow delete: if isSuperAdmin();
    }

    // ── absences ─────────────────────────────────────────────
    match /absences/{absenceId} {
      // Parent : uniquement les absences de SES enfants. Vérifié sur données
      // live (2026-06-10) : absences.eleveId == ID du doc eleves (codeMassar)
      // pour 100% des docs — TeacherAttendanceScreen écrit eleveId = eleve.id.
      // La requête parent (where eleveId in [enfants]) reste donc autorisée.
      allow read: if isAdmin()
                  || teacherTeaches(resource.data.classe)
                  || (isParent() && eleveParentUid(resource.data.eleveId) == myUid());
      // Durci 2026-07-11 — même logique que `notes` : cohérence élève/classe au
      // create, classe existante validée + eleveId/classe immuables à l'update.
      // (L'écran d'appel réécrit le doc à l'identique via set+merge, docId
      // déterministe → update autorisé, champs gelés inchangés.)
      allow create: if isAdmin() || (
        teacherTeaches(request.resource.data.classe)
        && eleveIsInClasse(request.resource.data.eleveId, request.resource.data.classe)
      );
      allow update: if isAdmin() || (
        teacherTeaches(resource.data.classe)
        && untouched(['eleveId', 'classe'])
      );
      allow delete: if isSuperAdmin();
    }

    // ── comportements (mérites / avertissements) ─────────────
    // Même périmètre que les absences : nominatif → le parent ne lit QUE
    // ses enfants, le prof QUE ses classes. Le prof peut retirer SA propre
    // entrée (erreur de saisie) ; le message parent déjà envoyé reste.
    match /comportements/{recordId} {
      allow read: if isAdmin()
                  || teacherTeaches(resource.data.classe)
                  || (isParent() && eleveParentUid(resource.data.eleveId) == myUid());
      allow create: if isAdmin()
        || (teacherTeaches(request.resource.data.classe)
            && request.resource.data.teacherId == myUid()
            // 2026-07-11 : cohérence élève/classe (même injection que notes).
            && eleveIsInClasse(request.resource.data.eleveId, request.resource.data.classe));
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (isTeacher() && resource.data.teacherId == myUid());
    }

    // ── classStats (agrégats ANONYMES par année/classe/semestre) ──
    // Maintenus par la CF onNoteWritten (Admin SDK) : moyennes de classe par
    // matière + tableau TRIÉ de moyennes d'élèves sans identifiants. C'est ce
    // que lit l'écran Notes parent pour moyenne/rang (au lieu des notes brutes
    // de toute la classe). Non nominatif → lisible par tout connecté.
    match /classStats/{statId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ── absenceRequests (absences déclarées par les parents) ──
    match /absenceRequests/{reqId} {
      // Parent : déclare pour SON enfant, en SON nom, statut 'pending' imposé.
      allow create: if isParent()
        && request.resource.data.parentUid == myUid()
        && eleveParentUid(request.resource.data.eleveId) == myUid()
        && request.resource.data.status == 'pending';
      allow read: if isAdmin()
        || (isParent() && resource.data.parentUid == myUid())
        || teacherTeaches(resource.data.classe);
      // Décision : prof de la classe / admin — champs de décision uniquement.
      // Durci 2026-07-11 : statut contraint aux valeurs réelles du client
      // ('approved'/'declined' — cf. decideAbsenceRequest ; PAS 'rejected'),
      // et décision signée (decidedBy == décideur réel).
      allow update: if (isAdmin() || teacherTeaches(resource.data.classe))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'decidedBy', 'decidedAt'])
        && request.resource.data.status in ['approved', 'declined']
        && request.resource.data.decidedBy == myUid();
      // Le parent peut retirer une déclaration tant qu'elle est en attente.
      allow delete: if isAdmin()
        || (isParent() && resource.data.parentUid == myUid() && resource.data.status == 'pending');
    }

    // ── bulletins ────────────────────────────────────────────
    match /bulletins/{bulletinId} {
      allow read: if isAdmin()
                  || teacherTeaches(resource.data.classe)
                  || (isParent() && eleveParentUid(resource.data.eleveId) == myUid());
      allow create, update: if isAdmin();
      allow delete:         if isSuperAdmin();
    }

    // ── devoirs (contenu pédagogique, non nominatif) ─────────
    match /devoirs/{devoirId} {
      // Lecture scopée (défense en profondeur — le filtre client par teacherId
      // ne suffit pas à empêcher l'énumération directe de la collection) :
      //   - admin  : tout
      //   - prof   : SES devoirs (teacherId) OU une classe qu'il enseigne
      //              → un prof ne lit plus les devoirs des autres profs/classes
      //   - parent : devoirs des classes de ses enfants. Le périmètre exact par
      //              enfant n'est PAS requêtable en règles (pas de query dans les
      //              règles) ; le contenu étant non nominatif, on cantonne au rôle.
      allow read: if isAdmin()
        || (isTeacher() && (resource.data.teacherId == myUid()
                            || teacherTeaches(resource.data.classeId)))
        || isParent();
      allow create, update: if isAdmin() || teacherTeaches(request.resource.data.classeId);
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == myUid());
    }

    // ── ressources (supports de cours, non nominatifs) ───────
    // Même périmètre de lecture que `devoirs`. `viewedBy` = compteur de
    // vues append-only : un lecteur ne peut que S'AJOUTER (selfAppendOnly,
    // comme messages.readBy) ; le prof propriétaire/admin édite le reste.
    match /ressources/{ressourceId} {
      // Même périmètre de lecture scopé que `devoirs` (défense en profondeur) :
      // admin = tout ; prof = ses ressources OU une classe qu'il enseigne ;
      // parent = large (contenu non nominatif, périmètre par enfant non
      // requêtable en règles). N'affecte pas l'update append-only de viewedBy.
      allow read: if isAdmin()
        || (isTeacher() && (resource.data.teacherId == myUid()
                            || teacherTeaches(resource.data.classeId)))
        || isParent();
      allow create: if isAdmin()
        || (teacherTeaches(request.resource.data.classeId)
            && request.resource.data.teacherId == myUid());
      allow update: if isSignedIn()
        && (
          resource.data.teacherId == myUid() || isAdmin()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy'])
        )
        && selfAppendOnly('viewedBy');
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == myUid());
    }

    // ── messages ─────────────────────────────────────────────
    match /messages/{messageId} {
      // Lecture : expéditeur, destinataire (uid dans toIds), diffusions ciblant
      // mon rôle, ou admin.
      //
      // DEUX statements `allow read` SÉPARÉS, c'est voulu (bug corrigé 2026-06-10) :
      // l'analyseur de requêtes de PROD ne sait pas prouver le disjoint
      // `toIds is list && uid in toIds` à l'intérieur du grand OR → la requête
      // where('toIds','array-contains',uid) était REFUSÉE pour tout le monde
      // (l'émulateur, lui, l'acceptait — ne pas s'y fier pour ça). Statement 1 :
      // grant minimal prouvable pour ce listener. Statement 2 : expression
      // complète inchangée (la garde `is list` y reste nécessaire car un doc
      // SANS toIds fait ERREUR sur `in`, et les erreurs ne sont PAS absorbées
      // par ||). Les statements étant évalués indépendamment, chacun couvre
      // l'angle mort de l'autre.
      allow read: if isSignedIn() && myUid() in resource.data.toIds;
      // Statement dédié pour la même raison que ci-dessus (requête
      // where('classe','==',X) du prof, cf. mojammaa-admin/Messages.tsx
      // subscribeClasse) : un prof lit les diffusions ADRESSÉES à SA classe
      // (champ `classe`, écrit par le compose web/app sur les messages
      // toType:'user'/toIds ciblant une classe). Ne concerne QUE les profs —
      // les parents reçoivent déjà ces messages via toIds (leur uid y figure).
      allow read: if isSignedIn() && teacherTeaches(resource.data.get('classe', ''));
      allow read: if isSignedIn() && (
        resource.data.fromId == myUid()
        || (resource.data.toIds is list && myUid() in resource.data.toIds)
        || resource.data.toType == 'all'
        || (resource.data.toType == 'parents'  && isParent())
        || (resource.data.toType == 'teachers' && isTeacher())
        || teacherTeaches(resource.data.get('classe', ''))
        // Compat ancien format (champ `toId` string) — cf. messagesService legacy.
        || resource.data.toId == myUid()
        || resource.data.toId == 'all'
        || (resource.data.toId == 'teachers' && isTeacher())
        || (resource.data.toId == 'admin'    && isAdmin())
        || isAdmin()
      );
      // Création : seulement en SON nom (anti-usurpation) ; les diffusions
      // larges (all/parents/teachers/class) réservées prof/admin.
      // Durci 23/06/2026 : `fromRole` ne peut pas mentir — s'il est présent il
      // DOIT valoir le rôle réel de l'auteur (sinon un parent pourrait poster un
      // message affiché comme « administration » → phishing in-app).
      // Durci 2026-07-11 : un parent n'écrit qu'à un petit nombre de
      // destinataires (compose parent réel = 1 prof OU les admins, reply = 1 ;
      // borne 10 = marge). Sans borne, un parent pouvait spammer d'un coup
      // tout le personnel listé dans directory/. Profs/admins non bornés
      // (envois de classe légitimes ≈ 30 uids).
      // Durci 2026-07-11 #3 : le PROF n'a plus AUCUNE diffusion générale
      // ('all'/'parents'/'teachers' = admin uniquement). Ses envois sont tous
      // toType:'user' (les helpers broadcastToParents/broadcastPersonalized/
      // notifications le forcent déjà) et un envoi multi-destinataires doit
      // être étiqueté d'une classe qu'il enseigne (le compose prof écrit
      // classe = "1A" ou "1A, 2B" → chaque partie doit être une DE SES
      // classes). L'envoi à 1 destinataire reste libre (réponse à un parent,
      // notification d'absence/comportement, message à l'admin).
      // Limite assumée : les règles ne peuvent pas vérifier uid par uid que
      // toIds ⊂ parents de la classe (pas de requête dans les règles) — la
      // borne réelle par destinataire viendra du refactor deliveries (CF).
      allow create: if isSignedIn()
        && request.resource.data.fromId == myUid()
        && (request.resource.data.toType == 'user' || isAdmin())
        && (isTeacher() || isAdmin()
            || (request.resource.data.toIds is list
                && request.resource.data.toIds.size() <= 10))
        && (!isTeacher()
            || request.resource.data.get('toIds', []).size() <= 1
            // classe non vide OBLIGATOIRE en multi-destinataires ('' absent
            // matcherait le filler legacy vide du concat ci-dessous).
            || (request.resource.data.get('classe', '') != ''
                && request.resource.data.classe.split(', ')
                     .hasOnly(myClasses().concat([myDoc().get('classe', '')]))))
        // Schéma unique (durci 2026-07-11 #2) : interdiction de MÉLANGER le
        // legacy `toId` avec le nouveau format — sinon un message 'user'
        // autorisé embarquait un toId:'all' lisible par toute l'école via le
        // chemin de lecture legacy (et fan-out push élargi côté CF). Les
        // anciens documents restent lisibles ; un write 100% legacy (toId
        // seul, sans toType/toIds) reste possible pour le staff.
        && !(request.resource.data.keys().hasAny(['toId'])
             && request.resource.data.keys().hasAny(['toType', 'toIds']))
        && (!request.resource.data.keys().hasAny(['fromRole'])
            || request.resource.data.fromRole == myRole())
        // Un parent ne signe pas d'un nom arbitraire (« Administration »… =
        // même phishing que fromRole) : fromNom doit être SON nom réel
        // (les deux ordres prénom/nom sont tolérés, cf. composes client).
        && (!isParent()
            || !request.resource.data.keys().hasAny(['fromNom'])
            || request.resource.data.fromNom.trim() in [
                 (myDoc().get('prenom', '') + ' ' + myDoc().get('nom', '')).trim(),
                 (myDoc().get('nom', '') + ' ' + myDoc().get('prenom', '')).trim(),
               ]);
      // MAJ : un destinataire ne touche QUE readBy/deletedBy, et seulement en
      // s'AJOUTANT lui-même (append-only). Intégrité requise : readBy devient
      // un accusé de lecture sur lequel l'école s'appuie — personne ne doit
      // pouvoir effacer/falsifier les lectures des autres (le client utilise
      // arrayUnion(uid), donc cette contrainte ne casse rien).
      //
      // ENVELOPPE IMMUABLE (durci 2026-07-11) : l'ancienne règle laissait
      // l'EXPÉDITEUR modifier toType/toIds/fromRole après envoi → un parent
      // créait un message 'user' autorisé puis le basculait en diffusion 'all'
      // signée « admin » (le garde-fou fromRole du 23/06 n'existait qu'au
      // create). Désormais :
      //  - expéditeur & destinataires : readBy/deletedBy en self-append, RIEN
      //    d'autre (aucun flux client n'édite un message après envoi — vérifié
      //    messagesService 2026-07-11) ;
      //  - admin : peut retoucher le CONTENU, jamais l'enveloppe
      //    (expéditeur/ciblage/horodatage).
      allow update: if isSignedIn()
        && (
          (isAdmin() && untouched(['fromId', 'fromNom', 'fromRole',
                                   'toType', 'toIds', 'toId', 'classe',
                                   'eleveId', 'createdAt']))
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'deletedBy'])
        )
        && selfAppendOnly('readBy')
        && selfAppendOnly('deletedBy');
      allow delete: if isAdmin();
    }

    // ── suivis (journal de suivi élève — back-office Statistiques) ──
    // Registre des actions de suivi (contact parent, entretien, convocation,
    // plan d'accompagnement). Contenu nominatif et sensible : personnel
    // uniquement — les PARENTS n'y ont PAS accès (ce sont des notes internes).
    // Création signée (createdBy == auteur) ; un prof ne modifie que les
    // siennes, l'admin gère tout.
    match /suivis/{suiviId} {
      allow read:   if isAdmin() || isTeacher();
      allow create: if (isAdmin() || isTeacher())
        && request.resource.data.createdBy == myUid();
      allow update: if isAdmin() || (isTeacher() && resource.data.createdBy == myUid());
      allow delete: if isAdmin();
    }

    // ── schedules (EDT prof) ─────────────────────────────────
    match /schedules/{teacherUid} {
      allow read:  if isSignedIn() && (teacherUid == myUid() || isAdmin());
      allow write: if isAdmin();
    }

    // ── infos scolaires non nominatives (lisibles par tous les connectés) ──
    match /emploiDuTemps/{docId}  { allow read: if isSignedIn(); allow write: if isAdmin(); }
    // evenements : calendrier scolaire. Lecture PUBLIQUE (non connectés inclus) —
    // l'agenda du site web public (mojammaa-admin/SchoolHome) interroge cette
    // collection sans authentification ; ce sont des infos non sensibles (titre,
    // type, dates). Durci 23/06/2026 côté écriture seulement : un prof ne peut
    // créer qu'un événement DONT IL EST PROPRIÉTAIRE (createdBy == son uid) et ne
    // peut modifier/supprimer QUE les siens ; l'admin gère tout.
    match /evenements/{eventId} {
      allow read:   if true;
      allow create: if isAdmin()
                    || (isTeacher() && request.resource.data.createdBy == myUid());
      allow update, delete: if isAdmin()
                    || (isTeacher() && resource.data.get('createdBy', '') == myUid());
    }
    match /joursScolaires/{dateId}{ allow read: if isSignedIn(); allow write: if isAdmin(); }

    // ── directory (annuaire du personnel, maintenu par CF) ──
    // Pour le compose parent : uid + nom + matière/classes des profs/admins
    // (AUCUNE donnée sensible — pas d'email ni de token). Écrit uniquement
    // par la CF onUserWritten (Admin SDK).
    match /directory/{docId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ── stats (agrégat du tableau de bord admin, maintenu par CF) ──
    // Document unique stats/summary calculé par aggregateSchoolStats /
    // recomputeSchoolStats (Admin SDK). Agrège TOUTE l'école (effectifs,
    // moyennes, présence…) → lecture ADMIN uniquement. Écriture INTERDITE
    // côté client (seul l'Admin SDK écrit, qui contourne les règles).
    match /stats/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── settings (paramètres pédagogiques — ex. coefficients des matières) ──
    // Distinct de config/ (verrouillé, superadmins) : ici l'ADMIN peut écrire
    // depuis le back-office ; lisible par tout connecté (l'app mobile pourra
    // pondérer les moyennes avec les mêmes coefficients).
    match /settings/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── config (liste des superadmins, etc.) ────────────────
    // Lecture ADMIN uniquement (l'app mobile ne lit jamais config/ — vérifié
    // 2026-06-10 ; inutile d'exposer la liste des superadmins aux parents).
    // Écriture INTERDITE depuis toute app : modifiable seulement via admin
    // SDK (scripts/setSuperadmin.js).
    match /config/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── auditLog (journal d'audit — Phase 2) ─────────────────
    // Append-only & inviolable : chaque connecté peut écrire une entrée EN SON
    // NOM ; seul un superadmin peut lire ; aucune modification/suppression.
    match /auditLog/{logId} {
      allow read:   if isSuperAdmin();
      allow create: if isSignedIn() && request.resource.data.actorUid == myUid();
      allow update, delete: if false;
    }

    // ── Default deny ─────────────────────────────────────────
    match /{document=**} { allow read, write: if false; }
  }
}
