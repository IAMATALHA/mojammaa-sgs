rules_version = '2';

// ============================================================================
//  RÈGLES DURCIES — PROPOSITION (à RELIRE + TESTER avant déploiement)
//
//  Objectif : un compte ne lit QUE ses données.
//    - parent  → son/ses enfant(s) (eleves.parentUid == uid) et leurs notes/absences
//    - prof    → uniquement SES classes (teacherTeaches) + SA matière pour les notes
//    - admin   → tout
//
//  ⚠️ AVANT DE DÉPLOYER :
//   1) Tester avec l'émulateur Firestore / un projet de staging, car des
//      règles plus strictes peuvent REJETER des requêtes existantes de l'app
//      (Firestore ne filtre pas : une requête qui POURRAIT toucher un doc
//       interdit est refusée en entier). Points à vérifier :
//        • Le dashboard PARENT doit interroger notes/absences par enfant
//          (eleveId / parentUid), PAS par classe seule.
//        • Le prof lit eleves/notes/absences de SES classes uniquement.
//   2) Déployer depuis UN SEUL endroit (ce fichier = la source unique).
//   3) Renommer en firestore.rules une fois validé.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }
    function myUid()      { return request.auth.uid; }
    function myDoc()      { return get(/databases/$(database)/documents/users/$(myUid())).data; }
    function myRole()     { return isSignedIn() ? myDoc().role : ''; }
    function isAdmin()    { return myRole() == 'admin'; }
    function isTeacher()  { return myRole() == 'professeur'; }
    function isParent()   { return myRole() == 'parent'; }
    function myClasses()  { return myDoc().classes != null ? myDoc().classes : []; }

    // ── Super-admin ──────────────────────────────────────────
    // Liste blanche dans config/superadmins (modifiable UNIQUEMENT via
    // scripts/setSuperadmin.js — admin SDK). Aucun client ne peut s'y ajouter.
    // Les superadmins gardent role:'admin' ; ce niveau ne fait qu'AJOUTER des
    // pouvoirs réservés (gestion des comptes/rôles, suppressions, audit).
    function superadminUids() {
      return get(/databases/$(database)/documents/config/superadmins).data.uids;
    }
    function isSuperAdmin() {
      return isSignedIn() && (myUid() in superadminUids());
    }

    // Le prof enseigne-t-il cette classe ? (tableau `classes` ou legacy `classe`)
    function teacherTeaches(classe) {
      return isTeacher() && (classe in myClasses() || classe == myDoc().classe);
    }
    // parentUid de l'élève ciblé (pour vérifier qu'un parent lit bien SON enfant)
    function eleveParentUid(eleveId) {
      return get(/databases/$(database)/documents/eleves/$(eleveId)).data.parentUid;
    }

    // ── users ────────────────────────────────────────────────
    match /users/{uid} {
      allow read:           if isSignedIn() && (uid == myUid() || isAdmin());
      // Créer/supprimer un compte : SUPERADMIN uniquement.
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin()
        // Admin : gère les profils (nom, classes, matière…) mais PAS le rôle.
        || (isAdmin() &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        // Soi-même : son profil SAUF champs sensibles (anti auto-élévation).
        || (isSignedIn() && uid == myUid() &&
            !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['role', 'classes', 'classe', 'matiere', 'cycle', 'uid']));
    }

    // ── eleves ───────────────────────────────────────────────
    match /eleves/{eleveId} {
      allow read: if isAdmin()
                  || (isParent()  && resource.data.parentUid == myUid())
                  || teacherTeaches(resource.data.classe);
      allow create, update: if isAdmin() || teacherTeaches(request.resource.data.classe);
      allow delete: if isSuperAdmin();
    }

    // ── notes ────────────────────────────────────────────────
    match /notes/{noteId} {
      // DETTE DE CONFIDENTIALITÉ (à durcir — cf. Option B) : le parent lit TOUTES
      // les notes, pas seulement celles de son enfant. Nécessaire tant que l'écran
      // Notes parent calcule la moyenne/le rang de classe via getClassNotes()
      // (lecture classe entière). À remplacer par un agrégat serveur, puis revenir à
      //   || (isParent() && eleveParentUid(resource.data.eleveId) == myUid())
      allow read: if isAdmin()
                  || teacherTeaches(resource.data.classe)
                  || isParent();
      // Prof : uniquement SA classe ET SA matière. Admin : tout.
      allow create, update: if isAdmin() || (
        teacherTeaches(request.resource.data.classe) &&
        request.resource.data.matiere == myDoc().matiere
      );
      allow delete: if isSuperAdmin();
    }

    // ── absences ─────────────────────────────────────────────
    match /absences/{absenceId} {
      // DETTE DE CONFIDENTIALITÉ (à durcir — cf. Option B) : le parent lit toutes
      // les absences. La règle stricte eleveParentUid() suppose que l'ID du doc
      // eleves == eleveId stocké dans absences (= codeMassar), ce qui n'est pas
      // garanti → on relâche pour ne pas casser l'écran Absences parent.
      allow read: if isAdmin()
                  || teacherTeaches(resource.data.classe)
                  || isParent();
      allow create, update: if isAdmin() || teacherTeaches(request.resource.data.classe);
      allow delete: if isSuperAdmin();
    }

    // ── bulletins ────────────────────────────────────────────
    match /bulletins/{bulletinId} {
      allow read: if isAdmin()
                  || teacherTeaches(resource.data.classe)
                  || (isParent() && eleveParentUid(resource.data.eleveId) == myUid());
      allow create, update: if isAdmin();
      allow delete:         if isSuperAdmin();
    }

    // ── devoirs (contenu pédagogique, non nominatif) ─────────
    match /devoirs/{devoirId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || teacherTeaches(request.resource.data.classeId);
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == myUid());
    }

    // ── messages ─────────────────────────────────────────────
    match /messages/{messageId} {
      // Lecture : expéditeur, destinataire (uid dans toIds), diffusions ciblant
      // mon rôle, ou admin.
      allow read: if isSignedIn() && (
        resource.data.fromId == myUid()
        || (resource.data.toIds is list && myUid() in resource.data.toIds)
        || resource.data.toType == 'all'
        || (resource.data.toType == 'parents'  && isParent())
        || (resource.data.toType == 'teachers' && isTeacher())
        // Compat ancien format (champ `toId` string) — cf. messagesService legacy.
        || resource.data.toId == myUid()
        || resource.data.toId == 'all'
        || (resource.data.toId == 'teachers' && isTeacher())
        || (resource.data.toId == 'admin'    && isAdmin())
        || isAdmin()
      );
      // Création : seulement en SON nom (anti-usurpation) ; les diffusions
      // larges (all/parents/teachers/class) réservées prof/admin.
      allow create: if isSignedIn()
        && request.resource.data.fromId == myUid()
        && (request.resource.data.toType == 'user' || isTeacher() || isAdmin());
      // MAJ : un destinataire ne touche QUE readBy/deletedBy ; sinon expéditeur/admin.
      allow update: if isSignedIn() && (
        resource.data.fromId == myUid() || isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'deletedBy'])
      );
      allow delete: if isAdmin();
    }

    // ── schedules (EDT prof) ─────────────────────────────────
    match /schedules/{teacherUid} {
      allow read:  if isSignedIn() && (teacherUid == myUid() || isAdmin());
      allow write: if isAdmin();
    }

    // ── infos scolaires non nominatives (lisibles par tous les connectés) ──
    match /emploiDuTemps/{docId}  { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /evenements/{eventId}   { allow read: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
    match /joursScolaires/{dateId}{ allow read: if isSignedIn(); allow write: if isAdmin(); }

    // ── config (liste des superadmins, etc.) ────────────────
    // Lisible par tout connecté (l'app peut vérifier si l'user est superadmin
    // pour afficher des écrans réservés). Écriture INTERDITE depuis toute app :
    // modifiable seulement via admin SDK (scripts/setSuperadmin.js).
    match /config/{docId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ── auditLog (journal d'audit — Phase 2) ─────────────────
    // Append-only & inviolable : chaque connecté peut écrire une entrée EN SON
    // NOM ; seul un superadmin peut lire ; aucune modification/suppression.
    match /auditLog/{logId} {
      allow read:   if isSuperAdmin();
      allow create: if isSignedIn() && request.resource.data.actorUid == myUid();
      allow update, delete: if false;
    }

    // ── Default deny ─────────────────────────────────────────
    match /{document=**} { allow read, write: if false; }
  }
}
