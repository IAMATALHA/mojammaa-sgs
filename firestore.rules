rules_version = '2';

// ============================================================================
//  RÈGLES DURCIES — PROPOSITION (à RELIRE + TESTER avant déploiement)
//
//  Objectif : un compte ne lit QUE ses données.
//    - parent  → son/ses enfant(s) (eleves.parentUid == uid) et leurs notes/absences
//    - prof    → uniquement SES classes (teacherTeaches) + SA matière pour les notes
//    - admin   → tout
//
//  ⚠️ AVANT DE DÉPLOYER :
//   1) Tester avec l'émulateur Firestore / un projet de staging, car des
//      règles plus strictes peuvent REJETER des requêtes existantes de l'app
//      (Firestore ne filtre pas : une requête qui POURRAIT toucher un doc
//       interdit est refusée en entier). Points à vérifier :
//        • Le dashboard PARENT doit interroger notes/absences par enfant
//          (eleveId / parentUid), PAS par classe seule.
//        • Le prof lit eleves/notes/absences de SES classes uniquement.
//   2) Déployer depuis UN SEUL endroit (ce fichier = la source unique).
//   3) Renommer en firestore.rules une fois validé.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }
    function myUid()      { return request.auth.uid; }
    function myDoc()      { return get(/databases/$(database)/documents/users/$(myUid())).data; }
    function myRole()     { return isSignedIn() ? myDoc().role : ''; }
    function isAdmin()    { return myRole() == 'admin'; }
    function isTeacher()  { return myRole() == 'professeur'; }
    function isParent()   { return myRole() == 'parent'; }
    function myClasses()  { return myDoc().classes != null ? myDoc().classes : []; }

    // ── Super-admin ──────────────────────────────────────────
    // Liste blanche dans config/superadmins (modifiable UNIQUEMENT via
    // scripts/setSuperadmin.js — admin SDK). Aucun client ne peut s'y ajouter.
    // Les superadmins gardent role:'admin' ; ce niveau ne fait qu'AJOUTER des
    // pouvoirs réservés (gestion des comptes/rôles, suppressions, audit).
    function superadminUids() {
      return get(/databases/$(database)/documents/config/superadmins).data.uids;
    }
    function isSuperAdmin() {
      return isSignedIn() && (myUid() in superadminUids());
    }

    // Le prof enseigne-t-il cette classe ? (tableau `classes` ou legacy `classe`)
    function teacherTeaches(classe) {
      return isTeacher() && (classe in myClasses() || classe == myDoc().classe);
    }
    // parentUid de l'élève ciblé (pour vérifier qu'un parent lit bien SON enfant)
    function eleveParentUid(eleveId) {
      return get(/databases/$(database)/documents/eleves/$(eleveId)).data.parentUid;
    }
    // Un champ tableau ne peut évoluer qu'en AJOUTANT son propre uid
    // (ou rester inchangé). Utilisé pour readBy/deletedBy des messages :
    // pas de retrait, pas d'ajout d'un autre uid, pas de réécriture.
    function selfAppendOnly(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
        || (request.resource.data[field] is list
            && request.resource.data[field].hasAll(resource.data.get(field, []))
            && request.resource.data[field].hasOnly(resource.data.get(field, []).concat([myUid()])));
    }

    // ── users ────────────────────────────────────────────────
    match /users/{uid} {
      allow read:           if isSignedIn() && (uid == myUid() || isAdmin());
      // Créer/supprimer un compte : SUPERADMIN uniquement.
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin()
        // Admin : gère les profils (nom, classes, matière…) mais PAS le rôle.
        || (isAdmin() &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        // Soi-même : son profil SAUF champs sensibles (anti auto-élévation).
        || (isSignedIn() && uid == myUid() &&
            !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['role', 'classes', 'classe', 'matiere', 'cycle', 'uid']));
    }

    // ── eleves ───────────────────────────────────────────────
    match /eleves/{eleveId} {
      allow read: if isAdmin()
                  || (isParent()  && resource.data.parentUid == myUid())
                  || teacherTeaches(resource.data.classe);
      allow create, update: if isAdmin() || teacherTeaches(request.resource.data.classe);
      allow delete: if isSuperAdmin();
    }

    // ── notes ────────────────────────────────────────────────
    match /notes/{noteId} {
      // DETTE DE CONFIDENTIALITÉ — dernier trou parent. L'agrégat serveur
      // (classStats, CF onNoteWritten) existe depuis Batch 1 et le client
      // useParentNotes ne lit plus la classe entière. MAIS l'ancien build
      // installé chez les parents appelle encore getClassNotes() → NE FLIPPER
      // qu'après adoption du build EAS Batch 1+. Règle cible :
      //   allow read: if isAdmin()
      //               || teacherTeaches(resource.data.classe)
      //               || (isParent() && eleveParentUid(resource.data.eleveId) == myUid());
      allow read: if isAdmin()
                  || teacherTeaches(resource.data.classe)
                  || isParent();
      // Prof : uniquement SA classe ET SA matière. Admin : tout.
      allow create, update: if isAdmin() || (
        teacherTeaches(request.resource.data.classe) &&
        request.resource.data.matiere == myDoc().matiere
      );
      allow delete: if isSuperAdmin();
    }

    // ── absences ─────────────────────────────────────────────
    match /absences/{absenceId} {
      // Parent : uniquement les absences de SES enfants. Vérifié sur données
      // live (2026-06-10) : absences.eleveId == ID du doc eleves (codeMassar)
      // pour 100% des docs — TeacherAttendanceScreen écrit eleveId = eleve.id.
      // La requête parent (where eleveId in [enfants]) reste donc autorisée.
      allow read: if isAdmin()
                  || teacherTeaches(resource.data.classe)
                  || (isParent() && eleveParentUid(resource.data.eleveId) == myUid());
      allow create, update: if isAdmin() || teacherTeaches(request.resource.data.classe);
      allow delete: if isSuperAdmin();
    }

    // ── classStats (agrégats ANONYMES par classe/semestre) ──
    // Maintenus par la CF onNoteWritten (Admin SDK) : moyennes de classe par
    // matière + tableau TRIÉ de moyennes d'élèves sans identifiants. C'est ce
    // que lit l'écran Notes parent pour moyenne/rang (au lieu des notes brutes
    // de toute la classe). Non nominatif → lisible par tout connecté.
    match /classStats/{statId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ── absenceRequests (absences déclarées par les parents) ──
    match /absenceRequests/{reqId} {
      // Parent : déclare pour SON enfant, en SON nom, statut 'pending' imposé.
      allow create: if isParent()
        && request.resource.data.parentUid == myUid()
        && eleveParentUid(request.resource.data.eleveId) == myUid()
        && request.resource.data.status == 'pending';
      allow read: if isAdmin()
        || (isParent() && resource.data.parentUid == myUid())
        || teacherTeaches(resource.data.classe);
      // Décision : prof de la classe / admin — champs de décision uniquement.
      allow update: if (isAdmin() || teacherTeaches(resource.data.classe))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'decidedBy', 'decidedAt']);
      // Le parent peut retirer une déclaration tant qu'elle est en attente.
      allow delete: if isAdmin()
        || (isParent() && resource.data.parentUid == myUid() && resource.data.status == 'pending');
    }

    // ── bulletins ────────────────────────────────────────────
    match /bulletins/{bulletinId} {
      allow read: if isAdmin()
                  || teacherTeaches(resource.data.classe)
                  || (isParent() && eleveParentUid(resource.data.eleveId) == myUid());
      allow create, update: if isAdmin();
      allow delete:         if isSuperAdmin();
    }

    // ── devoirs (contenu pédagogique, non nominatif) ─────────
    match /devoirs/{devoirId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || teacherTeaches(request.resource.data.classeId);
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == myUid());
    }

    // ── messages ─────────────────────────────────────────────
    match /messages/{messageId} {
      // Lecture : expéditeur, destinataire (uid dans toIds), diffusions ciblant
      // mon rôle, ou admin.
      //
      // DEUX statements `allow read` SÉPARÉS, c'est voulu (bug corrigé 2026-06-10) :
      // l'analyseur de requêtes de PROD ne sait pas prouver le disjoint
      // `toIds is list && uid in toIds` à l'intérieur du grand OR → la requête
      // where('toIds','array-contains',uid) était REFUSÉE pour tout le monde
      // (l'émulateur, lui, l'acceptait — ne pas s'y fier pour ça). Statement 1 :
      // grant minimal prouvable pour ce listener. Statement 2 : expression
      // complète inchangée (la garde `is list` y reste nécessaire car un doc
      // SANS toIds fait ERREUR sur `in`, et les erreurs ne sont PAS absorbées
      // par ||). Les statements étant évalués indépendamment, chacun couvre
      // l'angle mort de l'autre.
      allow read: if isSignedIn() && myUid() in resource.data.toIds;
      allow read: if isSignedIn() && (
        resource.data.fromId == myUid()
        || (resource.data.toIds is list && myUid() in resource.data.toIds)
        || resource.data.toType == 'all'
        || (resource.data.toType == 'parents'  && isParent())
        || (resource.data.toType == 'teachers' && isTeacher())
        // Compat ancien format (champ `toId` string) — cf. messagesService legacy.
        || resource.data.toId == myUid()
        || resource.data.toId == 'all'
        || (resource.data.toId == 'teachers' && isTeacher())
        || (resource.data.toId == 'admin'    && isAdmin())
        || isAdmin()
      );
      // Création : seulement en SON nom (anti-usurpation) ; les diffusions
      // larges (all/parents/teachers/class) réservées prof/admin.
      allow create: if isSignedIn()
        && request.resource.data.fromId == myUid()
        && (request.resource.data.toType == 'user' || isTeacher() || isAdmin());
      // MAJ : un destinataire ne touche QUE readBy/deletedBy, et seulement en
      // s'AJOUTANT lui-même (append-only). Intégrité requise : readBy devient
      // un accusé de lecture sur lequel l'école s'appuie — personne ne doit
      // pouvoir effacer/falsifier les lectures des autres (le client utilise
      // arrayUnion(uid), donc cette contrainte ne casse rien).
      // L'expéditeur/admin peut éditer les AUTRES champs, mais pas readBy.
      allow update: if isSignedIn()
        && (
          resource.data.fromId == myUid() || isAdmin()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'deletedBy'])
        )
        && selfAppendOnly('readBy')
        && selfAppendOnly('deletedBy');
      allow delete: if isAdmin();
    }

    // ── schedules (EDT prof) ─────────────────────────────────
    match /schedules/{teacherUid} {
      allow read:  if isSignedIn() && (teacherUid == myUid() || isAdmin());
      allow write: if isAdmin();
    }

    // ── infos scolaires non nominatives (lisibles par tous les connectés) ──
    match /emploiDuTemps/{docId}  { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /evenements/{eventId}   { allow read: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
    match /joursScolaires/{dateId}{ allow read: if isSignedIn(); allow write: if isAdmin(); }

    // ── directory (annuaire du personnel, maintenu par CF) ──
    // Pour le compose parent : uid + nom + matière/classes des profs/admins
    // (AUCUNE donnée sensible — pas d'email ni de token). Écrit uniquement
    // par la CF onUserWritten (Admin SDK).
    match /directory/{docId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ── config (liste des superadmins, etc.) ────────────────
    // Lecture ADMIN uniquement (l'app mobile ne lit jamais config/ — vérifié
    // 2026-06-10 ; inutile d'exposer la liste des superadmins aux parents).
    // Écriture INTERDITE depuis toute app : modifiable seulement via admin
    // SDK (scripts/setSuperadmin.js).
    match /config/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── auditLog (journal d'audit — Phase 2) ─────────────────
    // Append-only & inviolable : chaque connecté peut écrire une entrée EN SON
    // NOM ; seul un superadmin peut lire ; aucune modification/suppression.
    match /auditLog/{logId} {
      allow read:   if isSuperAdmin();
      allow create: if isSignedIn() && request.resource.data.actorUid == myUid();
      allow update, delete: if false;
    }

    // ── Default deny ─────────────────────────────────────────
    match /{document=**} { allow read, write: if false; }
  }
}
