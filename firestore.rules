rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function myUid() {
      return request.auth.uid;
    }
    function myDoc() {
      return get(/databases/$(database)/documents/users/$(myUid())).data;
    }
    function isAdmin() {
      return isSignedIn() && myDoc().role == 'admin';
    }
    function isTeacher() {
      return isSignedIn() && myDoc().role == 'professeur';
    }
    function isParent() {
      return isSignedIn() && myDoc().role == 'parent';
    }
    function teacherTeaches(classe) {
      return isTeacher() && (
        classe in (myDoc().classes != null ? myDoc().classes : []) ||
        classe == myDoc().classe
      );
    }

    // ── users ─────────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if isSignedIn() && (uid == myUid() || isAdmin());
      allow update: if isSignedIn() && uid == myUid()
                    && !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
                    || isAdmin();
      allow create, delete: if isAdmin();
    }

    // ── eleves ────────────────────────────────────────────────
    match /eleves/{eleveId} {
      allow read:   if isSignedIn();
      allow write:  if isAdmin() || isTeacher();
    }

    // ── schedules (EDT des profs) ────────────────────────────
    match /schedules/{teacherUid} {
      allow read:  if isSignedIn() && (teacherUid == myUid() || isAdmin());
      allow write: if isAdmin();
    }

    // ── emploiDuTemps (legacy EDT global) ────────────────────
    match /emploiDuTemps/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── evenements ───────────────────────────────────────────
    match /evenements/{eventId} {
      allow read:   if isSignedIn();
      allow write:  if isAdmin() || isTeacher();
    }

    // ── messages ─────────────────────────────────────────────
    match /messages/{messageId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.fromId == myUid() || isAdmin());
      allow delete: if isAdmin();
    }

    // ── absences ─────────────────────────────────────────────
    match /absences/{absenceId} {
      allow read:   if isSignedIn();
      allow create, update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    // ── notes ────────────────────────────────────────────────
    match /notes/{noteId} {
      allow read:   if isSignedIn();
      allow create, update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    // ── devoirs ──────────────────────────────────────────────
    match /devoirs/{devoirId} {
      allow read:   if isSignedIn();
      allow create, update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    // ── bulletins ────────────────────────────────────────────
    match /bulletins/{bulletinId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── joursScolaires (calendrier scolaire) ─────────────────
    match /joursScolaires/{dateId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Default deny ─────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
