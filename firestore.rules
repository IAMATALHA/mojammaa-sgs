rules_version = '2';

// ============================================================================
//  RÈGLES DURCIES — PROPOSITION (à RELIRE + TESTER avant déploiement)
//
//  Objectif : un compte ne lit QUE ses données.
//    - parent  → son/ses enfant(s) (eleves.parentUid == uid) et leurs notes/absences
//    - prof    → uniquement SES classes (teacherTeaches) + SA matière pour les notes
//    - admin   → tout
//
//  ⚠️ AVANT DE DÉPLOYER :
//   1) Tester avec l'émulateur Firestore / un projet de staging, car des
//      règles plus strictes peuvent REJETER des requêtes existantes de l'app
//      (Firestore ne filtre pas : une requête qui POURRAIT toucher un doc
//       interdit est refusée en entier). Points à vérifier :
//        • Le dashboard PARENT doit interroger notes/absences par enfant
//          (eleveId / parentUid), PAS par classe seule.
//        • Le prof lit eleves/notes/absences de SES classes uniquement.
//   2) Déployer depuis UN SEUL endroit (ce fichier = la source unique).
//   3) Renommer en firestore.rules une fois validé.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }
    function myUid()      { return request.auth.uid; }
    function myDoc()      { return get(/databases/$(database)/documents/users/$(myUid())).data; }
    function myRole()     { return isSignedIn() ? myDoc().role : ''; }
    function isAdmin()    { return myRole() == 'admin'; }
    function isTeacher()  { return myRole() == 'professeur'; }
    function isParent()   { return myRole() == 'parent'; }
    function myClasses()  { return myDoc().classes != null ? myDoc().classes : []; }

    // ── Super-admin ──────────────────────────────────────────
    // Liste blanche dans config/superadmins (modifiable UNIQUEMENT via
    // scripts/setSuperadmin.js — admin SDK). Aucun client ne peut s'y ajouter.
    // Les superadmins gardent role:'admin' ; ce niveau ne fait qu'AJOUTER des
    // pouvoirs réservés (gestion des comptes/rôles, suppressions, audit).
    function superadminUids() {
      return get(/databases/$(database)/documents/config/superadmins).data.uids;
    }
    function isSuperAdmin() {
      return isSignedIn() && (myUid() in superadminUids());
    }

    // Le prof enseigne-t-il cette classe ? (tableau `classes` ou legacy `classe`)
    function teacherTeaches(classe) {
      return isTeacher() && (classe in myClasses() || classe == myDoc().classe);
    }
    function ownsHomework(homeworkId) {
      return exists(/databases/$(database)/documents/devoirs/$(homeworkId))
        && get(/databases/$(database)/documents/devoirs/$(homeworkId)).data.teacherId == myUid();
    }
    function validHomeworkSubmissionStatus(status) {
      return status in [
        'pending', 'submitted', 'submitted_late', 'graded',
        'not_submitted', 'not_done', 'excused'
      ];
    }
    function validHomeworkSubmissionIdentity(submissionId, data) {
      return data.keys().hasAll([
          'homeworkId', 'eleveId', 'classeId', 'parentUid', 'teacherId', 'status'
        ])
        && submissionId == data.homeworkId + '_' + data.eleveId
        && data.homeworkId is string
        && data.eleveId is string
        && data.classeId is string
        && data.parentUid is string
        && data.teacherId is string
        && validHomeworkSubmissionStatus(data.status)
        && exists(/databases/$(database)/documents/devoirs/$(data.homeworkId))
        && exists(/databases/$(database)/documents/eleves/$(data.eleveId))
        && data.classeId ==
          get(/databases/$(database)/documents/devoirs/$(data.homeworkId)).data.classeId
        && data.teacherId ==
          get(/databases/$(database)/documents/devoirs/$(data.homeworkId)).data.teacherId
        && data.classeId ==
          get(/databases/$(database)/documents/eleves/$(data.eleveId)).data.classe
        && data.parentUid ==
          get(/databases/$(database)/documents/eleves/$(data.eleveId)).data.get('parentUid', '');
    }
    function validParentHomeworkProof(data) {
      return data.attachments is list
        && data.attachments.size() > 0
        && data.attachments.size() <= 5
        && data.get('parentComment', '') is string
        && data.get('parentComment', '').size() <= 500
        && data.submittedAt == request.time
        && data.updatedAt == request.time
        && data.submittedByUid == myUid();
    }
    // parentUid de l'élève ciblé. La capacité « espace parent » est additive :
    // le rôle principal peut rester professeur/chauffeur, mais le lien live
    // `eleves/{id}.parentUid == auth.uid` reste l'unique source d'autorité.
    function eleveParentUid(eleveId) {
      return get(/databases/$(database)/documents/eleves/$(eleveId)).data.parentUid;
    }
    function isGuardianOf(eleveId) {
      return isSignedIn() && eleveParentUid(eleveId) == myUid();
    }
    function ownsGuardianRecord(parentUid, eleveId) {
      return isSignedIn()
        && parentUid == myUid()
        && isGuardianOf(eleveId);
    }
    // Entitlement matérialisé par Admin SDK à chaque écriture d'élève. Il est
    // nécessaire pour les documents de classe non nominatifs (`devoirs`,
    // `ressources`) : les Rules ne savent pas requêter `eleves` pour prouver
    // qu'au moins un enfant du responsable appartient à une classe donnée.
    function hasGuardianAccess() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/guardianAccess/$(myUid()))
        && get(/databases/$(database)/documents/guardianAccess/$(myUid())).data.uid == myUid()
        && get(/databases/$(database)/documents/guardianAccess/$(myUid())).data.childIds is list
        && get(/databases/$(database)/documents/guardianAccess/$(myUid())).data.childIds.size() > 0;
    }
    function guardianHasClass(classe) {
      return hasGuardianAccess()
        && get(/databases/$(database)/documents/guardianAccess/$(myUid())).data.classes is list
        && classe in get(/databases/$(database)/documents/guardianAccess/$(myUid())).data.classes;
    }
    // Persona parent explicite pour un compte dont le rôle principal est
    // différent. Le message doit porter un élève encore lié au moment du write.
    function createsAsGuardian() {
      return request.resource.data.get('fromRole', '') == 'parent'
        && request.resource.data.keys().hasAny(['eleveId'])
        && isGuardianOf(request.resource.data.eleveId);
    }
    // Classe RÉELLE de l'élève ciblé (anti-injection 2026-07-11) : un prof ne
    // peut créer une note/absence/comportement QUE si l'élève appartient bien
    // à la classe déclarée dans le doc. Sans ce get(), un prof pouvait écrire
    // `classe: sa-classe, eleveId: élève-d-ailleurs` et le parent de la victime
    // voyait la donnée forgée (sa lecture ne filtre que sur eleveId).
    // ⚠️ COÛT : 1 get() par doc écrit → les batchs client doivent rester ≤ 10
    // docs (limite Firestore : 20 accès règles par batch). Les écrans appel &
    // import de notes committent par chunks (src/utils/firestoreBatch.ts).
    function eleveIsInClasse(eleveId, classe) {
      return get(/databases/$(database)/documents/eleves/$(eleveId)).data.classe == classe;
    }
    // Champs non modifiés par cet update (immutabilité sélective).
    function untouched(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }
    // Un champ tableau ne peut évoluer qu'en AJOUTANT son propre uid
    // (ou rester inchangé). Utilisé pour readBy/deletedBy des messages :
    // pas de retrait, pas d'ajout d'un autre uid, pas de réécriture.
    function selfAppendOnly(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
        || (request.resource.data[field] is list
            && request.resource.data[field].hasAll(resource.data.get(field, []))
            && request.resource.data[field].hasOnly(resource.data.get(field, []).concat([myUid()])));
    }

    // ── Smart Pickup helpers ────────────────────────────────
    function activeDriverUid(uid) {
      return exists(/databases/$(database)/documents/driverProfiles/$(uid))
        && get(/databases/$(database)/documents/driverProfiles/$(uid)).data.active == true;
    }
    function isActiveDriver() {
      return isSignedIn() && activeDriverUid(myUid());
    }
    function isAssignedTripDriver(tripId) {
      return isActiveDriver()
        && get(/databases/$(database)/documents/transportTrips/$(tripId)).data.driverUid == myUid();
    }
    function tripStatus(tripId) {
      return get(/databases/$(database)/documents/transportTrips/$(tripId)).data.status;
    }
    function pickupSessionIsOpen(serviceDate) {
      return exists(/databases/$(database)/documents/pickupSessions/$(serviceDate))
        && get(/databases/$(database)/documents/pickupSessions/$(serviceDate)).data.serviceDate == serviceDate
        && get(/databases/$(database)/documents/pickupSessions/$(serviceDate)).data.isOpen == true
        && get(/databases/$(database)/documents/pickupSessions/$(serviceDate)).data.opensAt <= request.time
        && get(/databases/$(database)/documents/pickupSessions/$(serviceDate)).data.closesAt >= request.time;
    }
    function validPassengerTransition(before, after) {
      return (before == 'scheduled' && after in ['boarded', 'absent', 'cancelled'])
        || (before == 'boarded' && after == 'dropped_off');
    }

    // ── Prière : suivi de classe uniquement ─────────────────
    function isPrayerStaffForClass(classe) {
      return isAdmin() || teacherTeaches(classe);
    }
    // ── users ────────────────────────────────────────────────
    match /users/{uid} {
      allow read:           if isSignedIn() && (uid == myUid() || isAdmin());
      // Créer/supprimer un compte : SUPERADMIN uniquement.
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin()
        // Admin : gère les profils (nom, classes, matière…) mais PAS le rôle,
        // ni la localisation de connexion (dérivée serveur, cf. Cloud Function
        // recordLoginLocation — jamais éditable, sinon perd toute valeur de preuve).
        || (isAdmin() &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'lastLoginLocation']))
        // Soi-même : son profil SAUF champs sensibles (anti auto-élévation) et
        // SAUF lastLoginLocation (sinon on pourrait se falsifier sa propre
        // localisation — seule la Cloud Function, via l'Admin SDK, l'écrit).
        || (isSignedIn() && uid == myUid() &&
            !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['role', 'classes', 'classe', 'matiere', 'cycle', 'uid', 'lastLoginLocation']));
    }

    // Document calculé côté serveur depuis `eleves.parentUid`. Un client ne
    // peut lire que sa propre capacité et ne peut jamais la fabriquer/modifier.
    match /guardianAccess/{uid} {
      allow read: if isSignedIn() && uid == myUid();
      allow write: if false;
    }

    // ── eleves ───────────────────────────────────────────────
    match /eleves/{eleveId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.parentUid == myUid())
                  || teacherTeaches(resource.data.classe);
      allow create: if isAdmin() || teacherTeaches(request.resource.data.classe);
      // Durci 2026-07-11 : l'ancienne règle ne validait que la NOUVELLE classe —
      // un prof pouvait cibler N'IMPORTE QUEL élève par ID (écriture aveugle,
      // pas besoin du droit de lecture) et le "capturer" en posant sa classe.
      // Désormais : ancienne ET nouvelle classe dans son périmètre, et
      // `parentUid` intouchable (sinon rattachement de l'enfant d'autrui à un
      // parent complice → fuite de toutes ses données).
      allow update: if isAdmin()
        || (teacherTeaches(resource.data.classe)
            && teacherTeaches(request.resource.data.classe)
            && untouched(['parentUid']));
      allow delete: if isSuperAdmin();
    }

    // ── notes ────────────────────────────────────────────────
    match /notes/{noteId} {
      // CONFIDENTIALITÉ FERMÉE (2026-06-22) — le parent ne lit QUE les notes
      // de SES enfants. L'agrégat serveur ANONYME (classStats, CF onNoteWritten)
      // fournit moyenne de classe + rang depuis Batch 1 (v1.0.4, 2026-06-10) ;
      // useParentNotes interroge `notes where eleveId == enfant` (jamais la
      // classe entière) → cette requête par-enfant reste autorisée. Données
      // live vérifiées 2026-06-22 : 100% des notes.eleveId == ID doc eleves,
      // donc eleveParentUid(eleveId) résout. (Ancien getClassNotes() supprimé
      // depuis v1.0.4 ; builds < 1.0.4 verraient leur requête classe refusée.)
      //
      // PROF restreint à SA matière (2026-06-25) — un prof ne lit QUE les notes
      // de SES classes ET de SA matière (parité avec la règle d'écriture). Les
      // lectures inter-matières (stats classe tous-sujets) ont été retirées du
      // client : TeacherNotesScreen interroge `where matiere == profile.matiere`,
      // donc reste autorisé. Un prof sans `matiere` (ancien compte) ne lit/écrit
      // aucune note — il ne peut de toute façon pas en saisir (règle write).
      allow read: if isAdmin()
                  || (teacherTeaches(resource.data.classe)
                      && resource.data.matiere == myDoc().matiere)
                  || isGuardianOf(resource.data.eleveId);
      // Prof : uniquement SA classe ET SA matière. Admin : tout.
      // Durci 2026-07-11 (anti-injection + anti-détournement) :
      //  - create : l'élève doit RÉELLEMENT appartenir à la classe déclarée
      //    (sinon note forgée visible par le parent d'un élève d'ailleurs) ;
      //  - update : on valide la classe EXISTANTE (plus seulement la nouvelle)
      //    et eleveId/classe/matiere deviennent immuables — un prof ne peut
      //    plus s'approprier une note hors périmètre en réécrivant sa classe.
      //    (L'app réécrit ces champs à l'identique via set+merge → inchangés,
      //    donc hors affectedKeys : aucun flux existant n'est cassé.)
      allow create: if isAdmin() || (
        teacherTeaches(request.resource.data.classe)
        && request.resource.data.matiere == myDoc().matiere
        && eleveIsInClasse(request.resource.data.eleveId, request.resource.data.classe)
      );
      allow update: if isAdmin() || (
        teacherTeaches(resource.data.classe)
        && resource.data.matiere == myDoc().matiere
        && untouched(['eleveId', 'classe', 'matiere'])
      );
      allow delete: if isSuperAdmin();
    }

    // ── absences ─────────────────────────────────────────────
    match /absences/{absenceId} {
      // Parent : uniquement les absences de SES enfants. Vérifié sur données
      // live (2026-06-10) : absences.eleveId == ID du doc eleves (codeMassar)
      // pour 100% des docs — TeacherAttendanceScreen écrit eleveId = eleve.id.
      // La requête parent (where eleveId in [enfants]) reste donc autorisée.
      allow read: if isAdmin()
                  || teacherTeaches(resource.data.classe)
                  || isGuardianOf(resource.data.eleveId);
      // Durci 2026-07-11 — même logique que `notes` : cohérence élève/classe au
      // create, classe existante validée + eleveId/classe immuables à l'update.
      // (L'écran d'appel réécrit le doc à l'identique via set+merge, docId
      // déterministe → update autorisé, champs gelés inchangés.)
      allow create: if isAdmin() || (
        teacherTeaches(request.resource.data.classe)
        && eleveIsInClasse(request.resource.data.eleveId, request.resource.data.classe)
      );
      allow update: if isAdmin() || (
        teacherTeaches(resource.data.classe)
        && untouched(['eleveId', 'classe'])
      );
      allow delete: if isSuperAdmin();
    }

    // ── comportements (mérites / avertissements) ─────────────
    // Même périmètre que les absences : nominatif → le parent ne lit QUE
    // ses enfants, le prof QUE ses classes. Le prof peut retirer SA propre
    // entrée (erreur de saisie) ; le message parent déjà envoyé reste.
    match /comportements/{recordId} {
      allow read: if isAdmin()
                  || teacherTeaches(resource.data.classe)
                  || isGuardianOf(resource.data.eleveId);
      allow create: if isAdmin()
        || (teacherTeaches(request.resource.data.classe)
            && request.resource.data.teacherId == myUid()
            // 2026-07-11 : cohérence élève/classe (même injection que notes).
            && eleveIsInClasse(request.resource.data.eleveId, request.resource.data.classe));
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (isTeacher() && resource.data.teacherId == myUid());
    }

    // ── classStats (agrégats ANONYMES par année/classe/semestre) ──
    // Maintenus par la CF onNoteWritten (Admin SDK) : moyennes de classe par
    // matière + tableau TRIÉ de moyennes d'élèves sans identifiants. C'est ce
    // que lit l'écran Notes parent pour moyenne/rang (au lieu des notes brutes
    // de toute la classe). Non nominatif → lisible par tout connecté.
    match /classStats/{statId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ── absenceRequests (absences déclarées par les parents) ──
    match /absenceRequests/{reqId} {
      // Responsable légal : déclare pour SON enfant, en SON nom, statut
      // 'pending' imposé. Son rôle principal peut être parent/prof/chauffeur.
      allow create: if ownsGuardianRecord(
          request.resource.data.parentUid,
          request.resource.data.eleveId
        )
        && request.resource.data.status == 'pending';
      allow read: if isAdmin()
        || ownsGuardianRecord(resource.data.parentUid, resource.data.eleveId)
        || teacherTeaches(resource.data.classe);
      // Décision : prof de la classe / admin — champs de décision uniquement.
      // Durci 2026-07-11 : statut contraint aux valeurs réelles du client
      // ('approved'/'declined' — cf. decideAbsenceRequest ; PAS 'rejected'),
      // et décision signée (decidedBy == décideur réel).
      allow update: if (isAdmin() || teacherTeaches(resource.data.classe))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'decidedBy', 'decidedAt'])
        && request.resource.data.status in ['approved', 'declined']
        && request.resource.data.decidedBy == myUid();
      // Le parent peut retirer une déclaration tant qu'elle est en attente.
      allow delete: if isAdmin()
        || (ownsGuardianRecord(resource.data.parentUid, resource.data.eleveId)
            && resource.data.status == 'pending');
    }

    // ── bulletins ────────────────────────────────────────────
    match /bulletins/{bulletinId} {
      allow read: if isAdmin()
                  || teacherTeaches(resource.data.classe)
                  || isGuardianOf(resource.data.eleveId);
      allow create, update: if isAdmin();
      allow delete:         if isSuperAdmin();
    }

    // ── devoirs (contenu pédagogique, non nominatif) ─────────
    match /devoirs/{devoirId} {
      // Lecture scopée (défense en profondeur — le filtre client par teacherId
      // ne suffit pas à empêcher l'énumération directe de la collection) :
      //   - admin  : tout
      //   - prof   : SES devoirs (teacherId) OU une classe qu'il enseigne
      //              → un prof ne lit plus les devoirs des autres profs/classes
      //   - responsable légal : classes exactes de guardianAccess, document
      //              serveur dérivé des liens eleves.parentUid (quel que soit
      //              son rôle principal).
      allow read: if isAdmin()
        || (isTeacher() && (resource.data.teacherId == myUid()
                            || teacherTeaches(resource.data.classeId)))
        || guardianHasClass(resource.data.classeId);
      allow create, update: if isAdmin() || teacherTeaches(request.resource.data.classeId);
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == myUid());
    }

    // ── homeworkSubmissions (statut nominatif du rendu) ─────────
    // Le parent envoie uniquement une preuve pour SON enfant. Il ne peut
    // jamais auto-valider « rendu ». Le professeur propriétaire décide du
    // statut final. L'admin garde la lecture globale pour les statistiques.
    match /homeworkSubmissions/{submissionId} {
      allow read: if isAdmin()
        || ownsGuardianRecord(resource.data.parentUid, resource.data.eleveId)
        || (isTeacher() && ownsHomework(resource.data.get('homeworkId', '')));

      allow create: if isAdmin()
        // Preuve initiale du parent : « envoyé », jamais « validé ».
        || (ownsGuardianRecord(
              request.resource.data.parentUid,
              request.resource.data.eleveId
            )
            && validHomeworkSubmissionIdentity(submissionId, request.resource.data)
            && request.resource.data.status == 'submitted'
            && request.resource.data.createdAt == request.time
            && request.resource.data.keys().hasOnly([
              'homeworkId', 'eleveId', 'classeId', 'parentUid', 'teacherId',
              'status', 'attachments', 'parentComment', 'submittedAt',
              'submittedByUid', 'createdAt', 'updatedAt'
            ])
            && validParentHomeworkProof(request.resource.data))
        // Première décision du professeur propriétaire.
        || (isTeacher()
            && ownsHomework(request.resource.data.get('homeworkId', ''))
            && validHomeworkSubmissionIdentity(submissionId, request.resource.data)
            && request.resource.data.teacherId == myUid()
            && request.resource.data.status in [
              'graded', 'not_submitted', 'not_done', 'excused'
            ]
            && request.resource.data.reviewedAt == request.time
            && request.resource.data.reviewedByUid == myUid()
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.keys().hasOnly([
              'homeworkId', 'eleveId', 'classeId', 'parentUid', 'teacherId',
              'status', 'attachments', 'parentComment', 'reviewedAt',
              'reviewedByUid', 'createdAt', 'updatedAt'
            ]));

      allow update: if isAdmin()
        // Le parent peut corriger son envoi. Après « non rendu/non fait », sa
        // nouvelle preuve devient explicitement « envoyée en retard » et doit
        // être revalidée par le professeur.
        || (ownsGuardianRecord(resource.data.parentUid, resource.data.eleveId)
            && validHomeworkSubmissionIdentity(submissionId, request.resource.data)
            && untouched([
              'homeworkId', 'eleveId', 'classeId', 'parentUid', 'teacherId',
              'createdAt', 'reviewedAt', 'reviewedByUid'
            ])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'attachments', 'parentComment', 'submittedAt',
              'submittedByUid', 'updatedAt'
            ])
            && ((resource.data.status in ['pending', 'submitted']
                  && request.resource.data.status == 'submitted')
                || (resource.data.status in [
                      'not_submitted', 'not_done', 'submitted_late'
                    ]
                    && request.resource.data.status == 'submitted_late'))
            && validParentHomeworkProof(request.resource.data))
        // Le professeur propriétaire est le seul décideur du statut final.
        || (isTeacher()
            && ownsHomework(resource.data.get('homeworkId', ''))
            && validHomeworkSubmissionIdentity(submissionId, request.resource.data)
            && request.resource.data.teacherId == myUid()
            && untouched([
              'homeworkId', 'eleveId', 'classeId', 'parentUid', 'teacherId',
              'attachments', 'parentComment', 'submittedAt',
              'submittedByUid', 'createdAt'
            ])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'reviewedAt', 'reviewedByUid', 'updatedAt'
            ])
            && request.resource.data.status in [
              'graded', 'not_submitted', 'not_done', 'excused'
            ]
            && request.resource.data.reviewedAt == request.time
            && request.resource.data.reviewedByUid == myUid()
            && request.resource.data.updatedAt == request.time);

      allow delete: if isAdmin();
    }

    // ── ressources (supports de cours, non nominatifs) ───────
    // Même périmètre de lecture que `devoirs`. `viewedBy` = compteur de
    // vues append-only : un lecteur ne peut que S'AJOUTER (selfAppendOnly,
    // comme messages.readBy) ; le prof propriétaire/admin édite le reste.
    match /ressources/{ressourceId} {
      // Même périmètre de lecture scopé que `devoirs` (défense en profondeur) :
      // admin = tout ; prof = ses ressources OU une classe qu'il enseigne ;
      // responsable légal = classes exactes de guardianAccess, quel que soit
      // son rôle principal. N'affecte pas l'append-only de viewedBy.
      allow read: if isAdmin()
        || (isTeacher() && (resource.data.teacherId == myUid()
                            || teacherTeaches(resource.data.classeId)))
        || guardianHasClass(resource.data.classeId);
      allow create: if isAdmin()
        || (teacherTeaches(request.resource.data.classeId)
            && request.resource.data.teacherId == myUid());
      allow update: if isSignedIn()
        && (
          resource.data.teacherId == myUid() || isAdmin()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy'])
        )
        && selfAppendOnly('viewedBy');
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == myUid());
    }

    // ── messages ─────────────────────────────────────────────
    match /messages/{messageId} {
      // Lecture : expéditeur, destinataire (uid dans toIds), diffusions ciblant
      // mon rôle, ou admin.
      //
      // DEUX statements `allow read` SÉPARÉS, c'est voulu (bug corrigé 2026-06-10) :
      // l'analyseur de requêtes de PROD ne sait pas prouver le disjoint
      // `toIds is list && uid in toIds` à l'intérieur du grand OR → la requête
      // where('toIds','array-contains',uid) était REFUSÉE pour tout le monde
      // (l'émulateur, lui, l'acceptait — ne pas s'y fier pour ça). Statement 1 :
      // grant minimal prouvable pour ce listener. Statement 2 : expression
      // complète inchangée (la garde `is list` y reste nécessaire car un doc
      // SANS toIds fait ERREUR sur `in`, et les erreurs ne sont PAS absorbées
      // par ||). Les statements étant évalués indépendamment, chacun couvre
      // l'angle mort de l'autre.
      allow read: if isSignedIn() && myUid() in resource.data.toIds;
      // Statement dédié pour la même raison que ci-dessus (requête
      // where('classe','==',X) du prof, cf. mojammaa-admin/Messages.tsx
      // subscribeClasse) : un prof lit les diffusions ADRESSÉES à SA classe
      // (champ `classe`, écrit par le compose web/app sur les messages
      // toType:'user'/toIds ciblant une classe). Ne concerne QUE les profs —
      // les parents reçoivent déjà ces messages via toIds (leur uid y figure).
      allow read: if isSignedIn() && teacherTeaches(resource.data.get('classe', ''));
      allow read: if isSignedIn() && (
        resource.data.fromId == myUid()
        || (resource.data.toIds is list && myUid() in resource.data.toIds)
        || resource.data.toType == 'all'
        || (resource.data.toType == 'parents'
            && hasGuardianAccess())
        || (resource.data.toType == 'teachers' && isTeacher())
        || teacherTeaches(resource.data.get('classe', ''))
        // Compat ancien format (champ `toId` string) — cf. messagesService legacy.
        || resource.data.toId == myUid()
        || resource.data.toId == 'all'
        || (resource.data.toId == 'parents'
            && hasGuardianAccess())
        || (resource.data.toId == 'teachers' && isTeacher())
        || (resource.data.toId == 'admin'    && isAdmin())
        || isAdmin()
      );
      // Création : seulement en SON nom (anti-usurpation) ; les diffusions
      // larges (all/parents/teachers/class) réservées prof/admin. Un compte
      // professionnel peut signer comme parent uniquement avec un eleveId
      // encore lié et récupère alors les mêmes bornes anti-spam qu'un parent.
      // Durci 23/06/2026 : `fromRole` ne peut pas mentir — s'il est présent il
      // DOIT valoir le rôle réel de l'auteur (sinon un parent pourrait poster un
      // message affiché comme « administration » → phishing in-app).
      // Durci 2026-07-11 : un parent n'écrit qu'à un petit nombre de
      // destinataires (compose parent réel = 1 prof OU les admins, reply = 1 ;
      // borne 10 = marge). Sans borne, un parent pouvait spammer d'un coup
      // tout le personnel listé dans directory/. Profs/admins non bornés
      // (envois de classe légitimes ≈ 30 uids).
      // Durci 2026-07-11 #3 : le PROF n'a plus AUCUNE diffusion générale
      // ('all'/'parents'/'teachers' = admin uniquement). Ses envois sont tous
      // toType:'user' (les helpers broadcastToParents/broadcastPersonalized/
      // notifications le forcent déjà) et un envoi multi-destinataires doit
      // être étiqueté d'une classe qu'il enseigne (le compose prof écrit
      // classe = "1A" ou "1A, 2B" → chaque partie doit être une DE SES
      // classes). L'envoi à 1 destinataire reste libre (réponse à un parent,
      // notification d'absence/comportement, message à l'admin).
      // Limite assumée : les règles ne peuvent pas vérifier uid par uid que
      // toIds ⊂ parents de la classe (pas de requête dans les règles) — la
      // borne réelle par destinataire viendra du refactor deliveries (CF).
      allow create: if isSignedIn()
        && request.resource.data.fromId == myUid()
        && (request.resource.data.toType == 'user'
            || (isAdmin() && !createsAsGuardian()))
        && ((isTeacher() || isAdmin()) && !createsAsGuardian()
            || (request.resource.data.toIds is list
                && request.resource.data.toIds.size() <= 10))
        && (!isTeacher() || createsAsGuardian()
            || request.resource.data.get('toIds', []).size() <= 1
            // classe non vide OBLIGATOIRE en multi-destinataires ('' absent
            // matcherait le filler legacy vide du concat ci-dessous).
            || (request.resource.data.get('classe', '') != ''
                && request.resource.data.classe.split(', ')
                     .hasOnly(myClasses().concat([myDoc().get('classe', '')]))))
        // Schéma unique (durci 2026-07-11 #2) : interdiction de MÉLANGER le
        // legacy `toId` avec le nouveau format — sinon un message 'user'
        // autorisé embarquait un toId:'all' lisible par toute l'école via le
        // chemin de lecture legacy (et fan-out push élargi côté CF). Les
        // anciens documents restent lisibles ; un write 100% legacy (toId
        // seul, sans toType/toIds) reste possible pour le staff.
        && !(request.resource.data.keys().hasAny(['toId'])
             && request.resource.data.keys().hasAny(['toType', 'toIds']))
        && (!request.resource.data.keys().hasAny(['fromRole'])
            || (request.resource.data.fromRole == myRole()
                && request.resource.data.fromRole != 'parent')
            || createsAsGuardian())
        // Un parent ne signe pas d'un nom arbitraire (« Administration »… =
        // même phishing que fromRole) : fromNom doit être SON nom réel
        // (les deux ordres prénom/nom sont tolérés, cf. composes client).
        && (!(isParent() || createsAsGuardian())
            || !request.resource.data.keys().hasAny(['fromNom'])
            || request.resource.data.fromNom.trim() in [
                 (myDoc().get('prenom', '') + ' ' + myDoc().get('nom', '')).trim(),
                 (myDoc().get('nom', '') + ' ' + myDoc().get('prenom', '')).trim(),
               ]);
      // MAJ : un destinataire ne touche QUE readBy/deletedBy, et seulement en
      // s'AJOUTANT lui-même (append-only). Intégrité requise : readBy devient
      // un accusé de lecture sur lequel l'école s'appuie — personne ne doit
      // pouvoir effacer/falsifier les lectures des autres (le client utilise
      // arrayUnion(uid), donc cette contrainte ne casse rien).
      //
      // ENVELOPPE IMMUABLE (durci 2026-07-11) : l'ancienne règle laissait
      // l'EXPÉDITEUR modifier toType/toIds/fromRole après envoi → un parent
      // créait un message 'user' autorisé puis le basculait en diffusion 'all'
      // signée « admin » (le garde-fou fromRole du 23/06 n'existait qu'au
      // create). Désormais :
      //  - expéditeur & destinataires : readBy/deletedBy en self-append, RIEN
      //    d'autre (aucun flux client n'édite un message après envoi — vérifié
      //    messagesService 2026-07-11) ;
      //  - admin : peut retoucher le CONTENU, jamais l'enveloppe
      //    (expéditeur/ciblage/horodatage).
      allow update: if isSignedIn()
        && (
          (isAdmin() && untouched(['fromId', 'fromNom', 'fromRole',
                                   'toType', 'toIds', 'toId', 'classe',
                                   'eleveId', 'createdAt']))
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'deletedBy'])
        )
        && selfAppendOnly('readBy')
        && selfAppendOnly('deletedBy');
      allow delete: if isAdmin();
    }

    // ── suivis (journal de suivi élève — back-office Statistiques) ──
    // Registre des actions de suivi (contact parent, entretien, convocation,
    // plan d'accompagnement). Contenu nominatif et sensible : personnel
    // uniquement — les PARENTS n'y ont PAS accès (ce sont des notes internes).
    // Création signée (createdBy == auteur) ; un prof ne modifie que les
    // siennes, l'admin gère tout.
    match /suivis/{suiviId} {
      allow read:   if isAdmin() || isTeacher();
      allow create: if (isAdmin() || isTeacher())
        && request.resource.data.createdBy == myUid();
      allow update: if isAdmin() || (isTeacher() && resource.data.createdBy == myUid());
      allow delete: if isAdmin();
    }

    // ── schedules (EDT prof) ─────────────────────────────────
    match /schedules/{teacherUid} {
      allow read:  if isSignedIn() && (teacherUid == myUid() || isAdmin());
      allow write: if isAdmin();
    }

    // ── infos scolaires non nominatives (lisibles par tous les connectés) ──
    match /emploiDuTemps/{docId}  { allow read: if isSignedIn(); allow write: if isAdmin(); }
    // evenements : calendrier scolaire. Lecture PUBLIQUE (non connectés inclus) —
    // l'agenda du site web public (mojammaa-admin/SchoolHome) interroge cette
    // collection sans authentification ; ce sont des infos non sensibles (titre,
    // type, dates). Durci 23/06/2026 côté écriture seulement : un prof ne peut
    // créer qu'un événement DONT IL EST PROPRIÉTAIRE (createdBy == son uid) et ne
    // peut modifier/supprimer QUE les siens ; l'admin gère tout.
    match /evenements/{eventId} {
      allow read:   if true;
      allow create: if isAdmin()
                    || (isTeacher() && request.resource.data.createdBy == myUid());
      allow update, delete: if isAdmin()
                    || (isTeacher() && resource.data.get('createdBy', '') == myUid());
    }
    match /joursScolaires/{dateId}{ allow read: if isSignedIn(); allow write: if isAdmin(); }

    // ── directory (annuaire du personnel, maintenu par CF) ──
    // Pour le compose parent : uid + nom + matière/classes des profs/admins
    // (AUCUNE donnée sensible — pas d'email ni de token). Écrit uniquement
    // par la CF onUserWritten (Admin SDK).
    match /directory/{docId} {
      allow read:  if isAdmin() || isTeacher() || hasGuardianAccess();
      allow write: if false;
    }

    // ── Smart Pickup : créneau opérationnel ─────────────────
    match /pickupSessions/{serviceDate} {
      allow read: if isSignedIn();

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'serviceDate', 'isOpen', 'openedByUid', 'opensAt', 'closesAt',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'serviceDate', 'isOpen', 'openedByUid', 'opensAt', 'closesAt',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.serviceDate == serviceDate
        && request.resource.data.isOpen == true
        && request.resource.data.openedByUid == myUid()
        && request.resource.data.opensAt == request.time
        && request.resource.data.closesAt is timestamp
        && request.resource.data.closesAt > request.time
        && request.resource.data.closesAt <= request.time + duration.value(6, 'h')
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && untouched(['serviceDate', 'createdAt'])
        && request.resource.data.serviceDate == serviceDate
        && request.resource.data.updatedAt == request.time
        && ((resource.data.isOpen == true
            && request.resource.data.isOpen == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'isOpen', 'closedAt', 'closedByUid', 'updatedAt'
            ])
            && request.resource.data.closedAt == request.time
            && request.resource.data.closedByUid == myUid())
          || (resource.data.isOpen == false
            && request.resource.data.isOpen == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'isOpen', 'openedByUid', 'opensAt', 'closesAt', 'closedAt',
              'closedByUid', 'updatedAt'
            ])
            && request.resource.data.openedByUid == myUid()
            && request.resource.data.opensAt == request.time
            && request.resource.data.closesAt is timestamp
            && request.resource.data.closesAt > request.time
            && request.resource.data.closesAt <= request.time + duration.value(6, 'h')
            && !request.resource.data.keys().hasAny(['closedAt', 'closedByUid']))
          || (resource.data.isOpen == true
            && resource.data.closesAt < request.time
            && request.resource.data.isOpen == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'openedByUid', 'opensAt', 'closesAt', 'updatedAt'
            ])
            && request.resource.data.openedByUid == myUid()
            && request.resource.data.opensAt == request.time
            && request.resource.data.closesAt is timestamp
            && request.resource.data.closesAt > request.time
            && request.resource.data.closesAt <= request.time + duration.value(6, 'h')));

      allow delete: if isSuperAdmin();
    }

    // ── Smart Pickup : sortie scolaire ──────────────────────
    match /pickupRequests/{requestId} {
      allow read: if isAdmin()
        || ownsGuardianRecord(resource.data.parentUid, resource.data.eleveId);

      // Une demande déterministe par élève/jour. Le lien parent-enfant est
      // résolu depuis eleves/ et ne dépend jamais d'un champ libre du client.
      allow create: if ownsGuardianRecord(
          request.resource.data.parentUid,
          request.resource.data.eleveId
        )
        && request.resource.data.keys().hasAll([
          'parentUid', 'eleveId', 'serviceDate', 'status', 'arrivedAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'parentUid', 'eleveId', 'serviceDate', 'status',
          'vehicleDescription', 'arrivedAt', 'updatedAt'
        ])
        && pickupSessionIsOpen(request.resource.data.serviceDate)
        && requestId == request.resource.data.serviceDate + '_' + request.resource.data.eleveId
        && request.resource.data.serviceDate is string
        && request.resource.data.status == 'waiting'
        && request.resource.data.get('vehicleDescription', '') is string
        && request.resource.data.get('vehicleDescription', '').size() <= 80
        && request.resource.data.arrivedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if
        // Parent : annulation avant appel uniquement.
        (ownsGuardianRecord(resource.data.parentUid, resource.data.eleveId)
          && resource.data.status == 'waiting'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelledAt', 'updatedAt'])
          && request.resource.data.cancelledAt == request.time
          && request.resource.data.updatedAt == request.time)
        // Parent : ré-annonce autorisée seulement après SA propre annulation.
        || (ownsGuardianRecord(resource.data.parentUid, resource.data.eleveId)
          && resource.data.status == 'cancelled'
          && request.resource.data.status == 'waiting'
          && pickupSessionIsOpen(resource.data.serviceDate)
          && untouched(['parentUid', 'eleveId', 'serviceDate'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'arrivedAt', 'updatedAt', 'cancelledAt', 'vehicleDescription'
          ])
          && !request.resource.data.keys().hasAny(['cancelledAt'])
          && request.resource.data.get('vehicleDescription', '') is string
          && request.resource.data.get('vehicleDescription', '').size() <= 80
          && request.resource.data.arrivedAt == request.time
          && request.resource.data.updatedAt == request.time)
        // Admin : machine d'état stricte waiting → called → ready → completed.
        || (isAdmin()
          && untouched(['parentUid', 'eleveId', 'serviceDate', 'arrivedAt'])
          && resource.data.parentUid == eleveParentUid(resource.data.eleveId)
          && request.resource.data.managedByUid == myUid()
          && request.resource.data.updatedAt == request.time
          && ((resource.data.status == 'waiting'
              && request.resource.data.status == 'called'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'calledAt', 'managedByUid', 'queueNumber', 'zone', 'updatedAt'
              ])
              && request.resource.data.calledAt == request.time
              && untouched(['readyAt', 'completedAt']))
            || (resource.data.status == 'called'
              && request.resource.data.status == 'ready'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'readyAt', 'managedByUid', 'queueNumber', 'zone', 'updatedAt'
              ])
              && request.resource.data.readyAt == request.time
              && untouched(['calledAt', 'completedAt']))
            || (resource.data.status == 'ready'
              && request.resource.data.status == 'completed'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'completedAt', 'managedByUid', 'queueNumber', 'zone', 'updatedAt'
              ])
              && request.resource.data.completedAt == request.time
              && untouched(['calledAt', 'readyAt']))));

      allow delete: if isSuperAdmin();
    }

    // Capacité additive : un parent peut aussi être chauffeur sans que son
    // users/{uid}.role ne change. L'auto-promotion client est impossible.
    match /driverProfiles/{uid} {
      allow read: if isSignedIn() && (uid == myUid() || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Le document trajet n'est PAS lisible par les parents : il décrirait la
    // tournée entière. Le parent lit seulement le passenger doc de son enfant.
    match /transportTrips/{tripId} {
      allow read: if isAdmin()
        || (isActiveDriver() && resource.data.driverUid == myUid());

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'driverUid', 'serviceDate', 'direction', 'routeId', 'routeLabel',
          'vehicleLabel', 'scheduledTime', 'stops', 'stopIds', 'status',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'driverUid', 'serviceDate', 'direction', 'routeId', 'routeLabel',
          'vehicleId', 'vehicleLabel', 'scheduledTime', 'stops', 'stopIds',
          'status', 'createdAt', 'updatedAt'
        ])
        && activeDriverUid(request.resource.data.driverUid)
        && request.resource.data.status == 'scheduled'
        && request.resource.data.direction in ['to_school', 'from_school']
        && request.resource.data.serviceDate is string
        && request.resource.data.routeId is string
        && request.resource.data.routeLabel is string
        && request.resource.data.vehicleLabel is string
        && request.resource.data.scheduledTime is string
        && request.resource.data.stops is list
        && request.resource.data.stops.size() > 0
        && request.resource.data.stops.size() <= 100
        && request.resource.data.stopIds is list
        && request.resource.data.stopIds.size() == request.resource.data.stops.size()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (isAdmin()
          || (isActiveDriver() && resource.data.driverUid == myUid()))
        && untouched([
          'driverUid', 'serviceDate', 'direction', 'routeId', 'routeLabel',
          'vehicleId', 'vehicleLabel', 'scheduledTime', 'stops', 'stopIds', 'createdAt',
          'status', 'boardingAt', 'startedAt', 'arrivedAt', 'completedAt',
          'cancelledAt', 'delayMinutes', 'delayReason', 'delayRevision',
          'delayUpdatedAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'currentStopId', 'etaMinutes', 'incidentMessage', 'updatedAt'
        ])
        && resource.data.status != 'completed'
        && resource.data.status != 'cancelled'
        && request.resource.data.get('etaMinutes', 0) is int
        && request.resource.data.get('etaMinutes', 0) >= 0
        && request.resource.data.get('etaMinutes', 0) <= 300
        && request.resource.data.get('delayMinutes', 0) is int
        && request.resource.data.get('delayMinutes', 0) >= 0
        && request.resource.data.get('delayMinutes', 0) <= 180
        && request.resource.data.get('delayReason', '') is string
        && request.resource.data.get('delayReason', '').size() <= 160
        && request.resource.data.get('incidentMessage', '') is string
        && request.resource.data.get('incidentMessage', '').size() <= 500
        && request.resource.data.get('currentStopId', '') is string
        && (request.resource.data.get('currentStopId', '') == ''
          || request.resource.data.currentStopId in resource.data.stopIds)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();

      match /passengers/{passengerId} {
        allow read: if isAdmin()
          || isAssignedTripDriver(tripId)
          || isGuardianOf(resource.data.eleveId);

        allow create: if isAdmin()
          && tripStatus(tripId) == 'scheduled'
          && request.resource.data.keys().hasAll([
            'tripId', 'eleveId', 'elevePrenom', 'serviceDate', 'direction',
            'routeLabel', 'vehicleLabel', 'scheduledTime', 'stopId',
            'stopLabel', 'status', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'tripId', 'eleveId', 'elevePrenom', 'eleveNom', 'classe',
            'serviceDate', 'direction', 'routeLabel', 'vehicleLabel',
            'scheduledTime', 'stopId', 'stopLabel', 'status',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.eleveId == passengerId
          && request.resource.data.tripId == tripId
          && request.resource.data.status == 'scheduled'
          && request.resource.data.serviceDate == get(/databases/$(database)/documents/transportTrips/$(tripId)).data.serviceDate
          && request.resource.data.direction == get(/databases/$(database)/documents/transportTrips/$(tripId)).data.direction
          && request.resource.data.routeLabel == get(/databases/$(database)/documents/transportTrips/$(tripId)).data.routeLabel
          && request.resource.data.vehicleLabel == get(/databases/$(database)/documents/transportTrips/$(tripId)).data.vehicleLabel
          && request.resource.data.scheduledTime == get(/databases/$(database)/documents/transportTrips/$(tripId)).data.scheduledTime
          && request.resource.data.stopId is string
          && request.resource.data.stopId in get(/databases/$(database)/documents/transportTrips/$(tripId)).data.stopIds
          && request.resource.data.stopLabel is string
          && request.resource.data.stopLabel.size() > 0
          && request.resource.data.stopLabel.size() <= 120
          && request.resource.data.elevePrenom is string
          && request.resource.data.elevePrenom.size() <= 80
          && request.resource.data.get('eleveNom', '') is string
          && request.resource.data.get('eleveNom', '').size() <= 80
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if (isAdmin() || isAssignedTripDriver(tripId))
          && untouched([
            'tripId', 'eleveId', 'elevePrenom', 'eleveNom', 'classe',
            'serviceDate', 'direction', 'routeLabel', 'vehicleLabel',
            'scheduledTime', 'stopId', 'stopLabel', 'createdAt'
          ])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'status', 'boardedAt', 'droppedOffAt', 'absentAt',
              'cancelledAt', 'updatedAt'
            ])
          && request.resource.data.status in [
            'scheduled', 'boarded', 'dropped_off', 'absent', 'cancelled'
          ]
          && validPassengerTransition(resource.data.status, request.resource.data.status)
          && request.resource.data.updatedAt == request.time
          && ((request.resource.data.status == 'boarded'
              && tripStatus(tripId) == 'boarding'
              && request.resource.data.boardedAt == request.time
              && untouched(['droppedOffAt', 'absentAt', 'cancelledAt']))
            || (request.resource.data.status == 'dropped_off'
              && tripStatus(tripId) in ['in_transit', 'arrived']
              && request.resource.data.droppedOffAt == request.time
              && untouched(['boardedAt', 'absentAt', 'cancelledAt']))
            || (request.resource.data.status == 'absent'
              && tripStatus(tripId) in ['scheduled', 'boarding']
              && request.resource.data.absentAt == request.time
              && untouched(['boardedAt', 'droppedOffAt', 'cancelledAt']))
            || (request.resource.data.status == 'cancelled'
              && tripStatus(tripId) in ['scheduled', 'boarding']
              && request.resource.data.cancelledAt == request.time
              && untouched(['boardedAt', 'droppedOffAt', 'absentAt'])));

        allow delete: if isAdmin();
      }
    }

    // Règles v2 : chemin récursif requis pour les requêtes collectionGroup
    // `passengers`. Le filtre eleveId de l'app permet aux rules de prouver le
    // lien courant ; une requête non bornée reste refusée.
    match /{path=**}/passengers/{passengerId} {
      allow read: if isGuardianOf(resource.data.eleveId);
    }

    // ── Déplacement d'une classe vers la prière ───────────────────────────
    // Suivi collectif uniquement : aucun identifiant élève. Une session est
    // créée au statut going puis avance strictement going → praying → returned.
    match /prayerClassSessions/{sessionId} {
      allow read: if isPrayerStaffForClass(resource.data.classe);

      // Seule la callable startPrayerClassSession (Admin SDK) crée le départ :
      // elle prouve côté serveur que le professeur a ce cours EN CE MOMENT.
      // Un client Firestore ne peut donc jamais contourner cette preuve.
      allow create: if false;

      allow update: if teacherTeaches(resource.data.classe)
        && resource.data.startedByUid == myUid()
        && untouched([
          'serviceDate', 'classe',
          'startedAt', 'startedByUid'
        ])
        && request.resource.data.updatedAt == request.time
        && ((resource.data.status == 'going'
            && request.resource.data.status == 'praying'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'prayingAt', 'prayingByUid', 'updatedAt'
            ])
            && request.resource.data.prayingAt == request.time
            && request.resource.data.prayingByUid == myUid()
            && !request.resource.data.keys().hasAny(['returnedAt', 'returnedByUid']))
          || (resource.data.status == 'praying'
            && request.resource.data.status == 'returned'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'returnedAt', 'returnedByUid', 'updatedAt'
            ])
            && request.resource.data.returnedAt == request.time
            && request.resource.data.returnedByUid == myUid()
            && untouched(['prayingAt', 'prayingByUid'])));

      allow delete: if false;
    }

    // ── stats (agrégat du tableau de bord admin, maintenu par CF) ──
    // Document unique stats/summary calculé par aggregateSchoolStats /
    // recomputeSchoolStats (Admin SDK). Agrège TOUTE l'école (effectifs,
    // moyennes, présence…) → lecture ADMIN uniquement. Écriture INTERDITE
    // côté client (seul l'Admin SDK écrit, qui contourne les règles).
    match /stats/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── settings (paramètres pédagogiques — ex. coefficients des matières) ──
    // Distinct de config/ (verrouillé, superadmins) : ici l'ADMIN peut écrire
    // depuis le back-office ; lisible par tout connecté (l'app mobile pourra
    // pondérer les moyennes avec les mêmes coefficients).
    match /settings/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── config (liste des superadmins, etc.) ────────────────
    // Lecture ADMIN uniquement (l'app mobile ne lit jamais config/ — vérifié
    // 2026-06-10 ; inutile d'exposer la liste des superadmins aux parents).
    // Écriture INTERDITE depuis toute app : modifiable seulement via admin
    // SDK (scripts/setSuperadmin.js).
    match /config/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── auditLog (journal d'audit — Phase 2) ─────────────────
    // Append-only & inviolable : chaque connecté peut écrire une entrée EN SON
    // NOM ; seul un superadmin peut lire ; aucune modification/suppression.
    match /auditLog/{logId} {
      allow read:   if isSuperAdmin();
      allow create: if isSignedIn() && request.resource.data.actorUid == myUid();
      allow update, delete: if false;
    }

    // ── Default deny ─────────────────────────────────────────
    match /{document=**} { allow read, write: if false; }
  }
}
