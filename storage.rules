rules_version = '2';

// ============================================================================
//  Storage rules — SOURCE DE VÉRITÉ : ce repo (comme firestore.rules).
//  Importées telles quelles depuis le ruleset live le 2026-06-10 (déployé à
//  l'origine depuis mojammaa-admin) ; désormais déployées d'ICI uniquement.
// ============================================================================
service firebase.storage {
  match /b/{bucket}/o {

    // Limites communes (durci 23/06/2026) : pièces jointes pédagogiques =
    // documents ou images uniquement, ≤ 25 Mo. Empêche l'upload de fichiers
    // arbitraires/volumineux servis ensuite à tous les utilisateurs.
    function isAllowedDoc() {
      return request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*|text/.*|application/vnd.*|application/msword');
    }

    function currentRole() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data.role;
    }

    // Devoirs : seul le prof propriétaire peut écrire dans son sous-dossier.
    // Lecture autorisée à tout utilisateur authentifié (parents, élèves,
    // autres profs, admin) — sinon le parent ne pourrait pas télécharger
    // la pièce jointe du devoir de son enfant.
    match /devoirs/{teacherUid}/{filename} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == teacherUid && isAllowedDoc();
    }

    // Preuves de devoir envoyées par les parents. L'écriture est limitée au
    // dossier du compte connecté, à SON enfant et à un devoir de sa classe.
    // La lecture est réservée au parent, au professeur propriétaire et à
    // l'administration.
    match /homework-submissions/{parentUid}/{filename} {
      allow create: if request.auth != null
        && request.auth.uid == parentUid
        && isAllowedDoc()
        && request.resource.metadata.parentUid == parentUid
        && firestore.get(
          /databases/(default)/documents/eleves/$(request.resource.metadata.eleveId)
        ).data.parentUid == parentUid
        && firestore.get(
          /databases/(default)/documents/eleves/$(request.resource.metadata.eleveId)
        ).data.classe == firestore.get(
          /databases/(default)/documents/devoirs/$(request.resource.metadata.homeworkId)
        ).data.classeId;

      allow read: if request.auth != null
        && resource.metadata.parentUid == parentUid
        && (request.auth.uid == parentUid
            || currentRole() == 'admin'
            || firestore.get(
              /databases/(default)/documents/devoirs/$(resource.metadata.homeworkId)
            ).data.teacherId == request.auth.uid);
    }

    // Imports de notes (Excel/CSV) : strictement privé au prof qui upload.
    match /notes-imports/{teacherUid}/{filename} {
      allow read:  if request.auth != null && request.auth.uid == teacherUid;
      allow write: if request.auth != null && request.auth.uid == teacherUid && isAllowedDoc();
    }

    // Ressources pédagogiques : même modèle que les devoirs — le prof
    // propriétaire écrit dans son sous-dossier, tout connecté peut lire.
    match /ressources/{teacherUid}/{filename} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == teacherUid && isAllowedDoc();
    }

    // Affiches d'annonces (admin uniquement). Le rôle est vérifié via
    // cross-service lookup Firestore (rules_version 2) : posséder le
    // sous-dossier ne suffit pas, il faut role == 'admin'.
    match /annonces/{adminUid}/{filename} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == adminUid
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Tout le reste : refusé par défaut.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
